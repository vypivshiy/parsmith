# ============================================================================
# parsmith Release Credentials (.env)
# ============================================================================
# Automatic token loader for .\scripts\publish-release.ps1
# Copy to .env and paste your tokens below without quotes.

# 1. Cargo (crates.io) -> https://crates.io/settings/tokens
CARGO_REGISTRY_TOKEN=

# 2. PyPI (pypi.org) -> https://pypi.org/manage/account/token/ (starts with pypi-...)
MATURIN_PYPI_TOKEN=

# 3. npm (npmjs.com) -> https://www.npmjs.com/settings/~/tokens (Granular Access Token, starts with npm_...)
NPM_TOKEN=

# 4. GitHub Releases (optional, for `gh release create`) -> https://github.com/settings/tokens
GH_TOKEN=
