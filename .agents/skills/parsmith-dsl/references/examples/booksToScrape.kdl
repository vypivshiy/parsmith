@doc "Books to Scrape (https://books.toscrape.com) — (table)struct, (list)struct, and pagination."

define BASE-URL="https://books.toscrape.com"

(table)struct ProductInfo {
    @table { css "table.table-striped" }
    @rows  { css-all "tr" }
    @match { css "th"; text; trim; lower }
    @value { css "td"; text; trim }
    @pre-validate { assert { css "table tr" } }

    upc               { match { eq "upc" } }
    product-type      { match { starts "product" } }
    price-excl-tax    { match { starts "price (ex" }; re #"(\d+\.\d+)"#; to-float }
    price-incl-tax    { match { starts "price (in" }; re #"(\d+\.\d+)"#; to-float }
    tax               { match { starts "tax" }; re #"(\d+\.\d+)"#; to-float }
    number-of-reviews { match { starts "number of" }; to-int; fallback 0 }

    is-available {
        match { eq "availability" }
        assert { contains "In stock" }
        to-bool
        fallback #false
    }
    count {
        match { eq "availability" }
        re #"(\d+)"#
        to-int
        fallback 0
    }
}

(list)struct Book {
    @split-doc { css-all ".col-lg-3" }
    @pre-validate { assert { css ".col-lg-3 .thumbnail" } }

    name { css ".thumbnail"; attr "alt"; trim }
    image-url {
        css ".thumbnail"
        attr "src"
        rm-prefix ".."
        ltrim "./"
        fmt "{{BASE-URL}}/{{}}"
    }
    rating {
        css ".star-rating"
        attr "class"
        rm-prefix "star-rating "
        repl { "One" "1"; "Two" "2"; "Three" "3"; "Four" "4"; "Five" "5" }
        to-int
    }
    price {
        css ".price_color"
        text
        re #"(\d+(?:\.\d+)?)"#
        to-float
    }
}

struct MainCatalogue {
    prev-page {
        css ".previous a"
        attr "href"
        rm-prefix "catalogue/"
        fmt "{{BASE-URL}}/catalogue/{{}}"
        fallback #null
    }
    next-page {
        css ".next a"
        attr "href"
        rm-prefix "catalogue/"
        fmt "{{BASE-URL}}/catalogue/{{}}"
        fallback #null
    }
    curr-page {
        css ".current"
        text
        re #"Page\s+(\d+)"#
        fmt "{{BASE-URL}}/catalogue/page-{{}}.html"
    }
    books { nested Book }
}
