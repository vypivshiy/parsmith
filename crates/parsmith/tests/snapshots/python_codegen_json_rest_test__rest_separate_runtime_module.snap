# Auto-generated runtime helpers by parsmith. DO NOT EDIT.
from __future__ import annotations

from html import unescape as html_unescape
import re
from collections.abc import Iterable, Mapping
from contextlib import AbstractAsyncContextManager
from dataclasses import dataclass
from dataclasses import field
import json
import urllib.error
import urllib.parse
import urllib.request
from collections.abc import Callable
from typing import Any, Generic, Literal, Protocol, TypeVar

class RtAssertionError(ValueError):
    pass


def rt_assert(cond: bool, msg: str = "") -> None:
    if not cond:
        raise RtAssertionError(msg or "parsmith assertion failed")

class RtRegexError(ValueError):
    pass


def rt_re_search(pattern: str, value: str, msg: str = "") -> str:
    m = re.search(pattern, value)
    if m is None:
        raise RtRegexError(msg or "parsmith re-match failed")
    return m[1]

def rt_repl_map(s: str, replacements: dict[str, str]) -> str:
    for old, new in replacements.items():
        s = s.replace(old, new)
    return s

RT_RE_HEX_ENTITY = re.compile(r"&#x([0-9a-fA-F]+);")
RT_RE_UNICODE_ENTITY = re.compile(r"\\u([0-9a-fA-F]{4})")
RT_RE_BYTES_ENTITY = re.compile(r"\\x([0-9a-fA-F]{2})")
RT_RE_CHARS_MAP: dict[str, str] = {
    "\\b": "\b",
    "\\f": "\f",
    "\\n": "\n",
    "\\r": "\r",
    "\\t": "\t",
}


def rt_unescape_text(text: str) -> str:
    s = html_unescape(text)
    s = RT_RE_HEX_ENTITY.sub(lambda m: chr(int(m.group(1), 16)), s)
    s = RT_RE_UNICODE_ENTITY.sub(lambda m: chr(int(m.group(1), 16)), s)
    s = RT_RE_BYTES_ENTITY.sub(lambda m: chr(int(m.group(1), 16)), s)
    for ch, r in RT_RE_CHARS_MAP.items():
        s = s.replace(ch, r)
    return s

class RtUnmatchedTableRow:
    pass


RT_UNMATCHED_TABLE_ROW = RtUnmatchedTableRow()

class RtJsonError(ValueError):
    pass


class RtJsonPathError(RtJsonError):
    pass


class RtJsonFieldMissingError(RtJsonError):
    pass


class RtJsonSchemaError(RtJsonError):
    pass


def rt_expect_dict(data: Any, target: str = "") -> dict[str, Any]:
    if not isinstance(data, dict):
        prefix = f"{target}: " if target else ""
        raise RtJsonSchemaError(f"{prefix}Expected dict, got {type(data).__name__}")
    return data


def rt_expect_list(data: Any, target: str = "") -> list[Any]:
    if not isinstance(data, list):
        prefix = f"{target}: " if target else ""
        raise RtJsonSchemaError(f"{prefix}Expected list, got {type(data).__name__}")
    return data


def rt_resolve_dotpath(
    data: Any, path: str, is_optional: bool = False, target: str = ""
) -> Any:
    prefix = f"{target}: " if target else ""
    raw_segs: list[str] = []
    buf: list[str] = []
    i = 0
    n = len(path)
    while i < n:
        ch = path[i]
        if ch == "\\" and i + 1 < n and path[i + 1] in (".", "\\", "#"):
            buf.append(ch)
            buf.append(path[i + 1])
            i += 2
        elif ch == ".":
            raw_segs.append("".join(buf))
            buf = []
            i += 1
        else:
            buf.append(ch)
            i += 1
    raw_segs.append("".join(buf))
    current: Any = data
    for idx_seg, raw_seg in enumerate(raw_segs):
        if raw_seg == "#":
            if current is None:
                if is_optional:
                    return None
                raise RtJsonPathError(
                    f"{prefix}Cannot traverse segment '#' on null object in path '{path}'"
                )
            if not isinstance(current, list):
                if is_optional:
                    return None
                raise RtJsonPathError(
                    f"{prefix}Expected list for '#' in path '{path}', got {type(current).__name__}"
                )
            if idx_seg == len(raw_segs) - 1:
                return len(current)
            subpath = ".".join(raw_segs[idx_seg + 1 :])
            out: list[Any] = []
            for item in current:
                v = rt_resolve_dotpath(item, subpath, is_optional=True, target=target)
                if v is not None:
                    out.append(v)
            return out
        has_escape = "\\" in raw_seg
        if has_escape:
            seg_chars: list[str] = []
            j = 0
            m = len(raw_seg)
            while j < m:
                if (
                    raw_seg[j] == "\\"
                    and j + 1 < m
                    and raw_seg[j + 1] in (".", "\\", "#")
                ):
                    seg_chars.append(raw_seg[j + 1])
                    j += 2
                else:
                    seg_chars.append(raw_seg[j])
                    j += 1
            seg = "".join(seg_chars)
        else:
            seg = raw_seg
        if current is None:
            if is_optional:
                return None
            raise RtJsonPathError(
                f"{prefix}Cannot traverse segment '{seg}' on null object in path '{path}'"
            )
        if not has_escape and seg.isdigit():
            idx = int(seg)
            if not isinstance(current, list):
                if is_optional:
                    return None
                raise RtJsonPathError(
                    f"{prefix}Expected list for index '{idx}' in path '{path}', got {type(current).__name__}"
                )
            if not (0 <= idx < len(current)):
                if is_optional:
                    return None
                raise RtJsonPathError(
                    f"{prefix}Index {idx} out of bounds (len={len(current)}) in path '{path}'"
                )
            current = current[idx]
        elif isinstance(current, dict):
            if seg not in current:
                if is_optional:
                    return None
                raise RtJsonPathError(
                    f"{prefix}Missing key '{seg}' in path '{path}'"
                )
            current = current[seg]
        else:
            if is_optional:
                return None
            raise RtJsonPathError(
                f"{prefix}Cannot access key '{seg}' on non-dict {type(current).__name__} in path '{path}'"
            )
    return current


def rt_json_req(data: dict[str, Any], key: str, target: str = "") -> Any:
    fname = target.rsplit(".", 1)[-1] if "." in target else key
    qual = target if (not target or "." in target) else f"{target}.{fname}"
    prefix = f"{qual}: " if qual else ""
    if key not in data:
        raise RtJsonFieldMissingError(
            f"{prefix}Required JSON field '{key}' (mapped to '{fname}') is missing"
        )
    val = data[key]
    if val is None:
        raise RtJsonFieldMissingError(
            f"{prefix}Field '{key}' is null, but '{fname}' is not nullable"
        )
    return val


def rt_json_req_path(data: Any, path: str, target: str = "") -> Any:
    val = rt_resolve_dotpath(data, path, is_optional=False, target=target)
    if val is None:
        prefix = f"{target}: " if target else ""
        fname = target.rsplit(".", 1)[-1] if "." in target else path
        raise RtJsonFieldMissingError(
            f"{prefix}Field '{path}' is null, but '{fname}' is not nullable"
        )
    return val

@dataclass(slots=True, frozen=True)
class HttpRequest:
    method: str
    url: str
    headers: dict[str, str] = field(default_factory=dict)
    params: dict[str, str | list[str]] = field(default_factory=dict)
    cookies: dict[str, str] = field(default_factory=dict)
    body: Any = None
    body_kind: Literal["empty", "json", "form", "raw"] = "empty"
    extra: dict[str, Any] = field(default_factory=dict)


@dataclass(slots=True, frozen=True)
class RawResponse:
    status: int
    headers: dict[str, str]
    text: str


class TransportError(Exception):
    def __init__(self, cause: BaseException) -> None:
        super().__init__(str(cause))
        self.cause = cause


class HttpStatusError(Exception):
    def __init__(self, response: RawResponse) -> None:
        snippet = response.text[:200]
        msg = f"HTTP {response.status}: {snippet}" if snippet else f"HTTP {response.status}"
        super().__init__(msg)
        self.response: RawResponse = response
        self.status: int = response.status
        self.headers: dict[str, str] = response.headers
        self.text: str = response.text


class HeadersLike(Protocol):
    def items(self) -> Iterable[tuple[Any, Any]]: ...


class HttpResponseLike(Protocol):
    @property
    def status_code(self) -> int: ...

    @property
    def headers(self) -> HeadersLike: ...

    @property
    def text(self) -> str: ...


class AiohttpResponseLike(Protocol):
    @property
    def status(self) -> int: ...

    @property
    def headers(self) -> HeadersLike: ...

    async def text(self) -> str: ...


class HttpxLike(Protocol):
    def request(
        self,
        method: str,
        url: str,
        *,
        content: Any = ...,
        data: Any = ...,
        json: Any = ...,
        params: Any = ...,
        headers: Any = ...,
        cookies: Any = ...,
    ) -> HttpResponseLike: ...


class AsyncHttpxLike(Protocol):
    async def request(
        self,
        method: str,
        url: str,
        *,
        content: Any = ...,
        data: Any = ...,
        json: Any = ...,
        params: Any = ...,
        headers: Any = ...,
        cookies: Any = ...,
    ) -> HttpResponseLike: ...


class RequestsLike(Protocol):
    def request(
        self,
        method: str,
        url: str,
        *,
        params: Any = ...,
        data: Any = ...,
        headers: Any = ...,
        cookies: Any = ...,
        json: Any = ...,
