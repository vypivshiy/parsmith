class RequestsTransport:
    def __init__(self, session: RequestsLike) -> None:
        self._session = session

    def send(self, req: HttpRequest) -> RawResponse:
        kw: dict[str, Any] = {}
        if req.headers:
            kw["headers"] = req.headers
        if req.params:
            kw["params"] = req.params
        if req.cookies:
            kw["cookies"] = req.cookies
        if req.body_kind == "json":
            kw["json"] = req.body
        elif req.body_kind in ("form", "raw") and req.body is not None:
            kw["data"] = req.body
        kw.update(req.extra)
        try:
            resp = self._session.request(req.method, req.url, **kw)
            status = int(resp.status_code)
            headers = {str(k).lower(): str(v) for k, v in resp.headers.items()}
            text = str(resp.text)
        except (TypeError, AttributeError):
            raise
        except Exception as e:
            raise TransportError(e) from e
        return RawResponse(status=status, headers=headers, text=text)


class AiohttpTransport:
    def __init__(self, session: AiohttpLike) -> None:
        self._session = session

    async def send(self, req: HttpRequest) -> RawResponse:
        kw: dict[str, Any] = {}
        if req.headers:
            kw["headers"] = req.headers
        if req.params:
            kw["params"] = req.params
        if req.cookies:
            kw["cookies"] = req.cookies
        if req.body_kind == "json":
            kw["json"] = req.body
        elif req.body_kind in ("form", "raw") and req.body is not None:
            kw["data"] = req.body
        kw.update(req.extra)
        try:
            async with self._session.request(req.method, req.url, **kw) as resp:
                text = await resp.text()
                status = int(resp.status)
                headers = {str(k).lower(): str(v) for k, v in resp.headers.items()}
        except (TypeError, AttributeError):
            raise
        except Exception as e:
            raise TransportError(e) from e
        return RawResponse(status=status, headers=headers, text=str(text))


class UrllibTransport:
    def __init__(self, timeout: float | None = None) -> None:
        self._timeout = timeout

    def send(self, req: HttpRequest) -> RawResponse:
        url = req.url
        if req.params:
            pairs: list[tuple[str, str]] = []
            for k, v in req.params.items():
                if isinstance(v, list):
                    for item in v:
                        pairs.append((k, str(item)))
                elif v is not None:
                    pairs.append((k, str(v)))
            if pairs:
                qs = urllib.parse.urlencode(pairs)
                sep = "&" if "?" in url else "?"
                url = f"{url}{sep}{qs}"
        headers: dict[str, str] = dict(req.headers)
        if req.cookies:
            cookie_str = "; ".join(f"{k}={v}" for k, v in req.cookies.items())
            if "Cookie" in headers:
                headers["Cookie"] = f"{headers['Cookie']}; {cookie_str}"
            else:
                headers["Cookie"] = cookie_str
        data_bytes: bytes | None = None
        if req.body_kind == "json" and req.body is not None:
            data_bytes = json.dumps(req.body).encode("utf-8")
            if not any(k.lower() == "content-type" for k in headers):
                headers["Content-Type"] = "application/json"
        elif req.body_kind == "form" and req.body is not None:
            if isinstance(req.body, dict):
                data_bytes = urllib.parse.urlencode(req.body, doseq=True).encode("utf-8")
            else:
                data_bytes = str(req.body).encode("utf-8")
            if not any(k.lower() == "content-type" for k in headers):
                headers["Content-Type"] = "application/x-www-form-urlencoded"
        elif req.body_kind == "raw" and req.body is not None:
            if isinstance(req.body, bytes):
                data_bytes = req.body
            else:
                data_bytes = str(req.body).encode("utf-8")
        ureq = urllib.request.Request(url, data=data_bytes, headers=headers, method=req.method)
        timeout = req.extra.get("timeout", self._timeout)
        try:
            with urllib.request.urlopen(ureq, timeout=timeout) as resp:
                raw_bytes: bytes = resp.read()
                resp_headers = {str(k).lower(): str(v) for k, v in resp.headers.items()}
                return RawResponse(
                    status=int(resp.status),
                    headers=resp_headers,
                    text=raw_bytes.decode("utf-8", errors="replace"),
                )
        except urllib.error.HTTPError as e:
            err_bytes = e.read() if hasattr(e, "read") else b""
            err_headers = (
                {str(k).lower(): str(v) for k, v in e.headers.items()}
                if e.headers is not None
                else {}
            )
            return RawResponse(
                status=int(e.code),
                headers=err_headers,
                text=err_bytes.decode("utf-8", errors="replace"),
            )
        except urllib.error.URLError as e:
            raise TransportError(e) from e


def via_httpx(client: HttpxLike) -> HttpxTransport:
    return HttpxTransport(client)


def via_httpx_async(client: AsyncHttpxLike) -> AsyncHttpxTransport:
    return AsyncHttpxTransport(client)


def via_requests(session: RequestsLike) -> RequestsTransport:
    return RequestsTransport(session)


def via_aiohttp(session: AiohttpLike) -> AiohttpTransport:
    return AiohttpTransport(session)


def via_urllib(timeout: float | None = None) -> UrllibTransport:
    return UrllibTransport(timeout)


def rt_build_request(
    method: str,
    url: str,
    *,
    headers: Mapping[str, Any] | None = None,
    params: Mapping[str, Any] | None = None,
    cookies: Mapping[str, Any] | None = None,
    body: Any = None,
    body_kind: Literal["empty", "json", "form", "raw"] = "empty",
    extra: Mapping[str, Any] | None = None,
) -> HttpRequest:
    clean_headers: dict[str, str] = {}
    if headers:
        for k, v in headers.items():
            if v is not None:
                clean_headers[str(k)] = str(v)
    clean_params: dict[str, str | list[str]] = {}
    if params:
        for k, v in params.items():
            if v is None:
                continue
            if isinstance(v, list):
                clean_params[str(k)] = [str(x) for x in v if x is not None]
            else:
                clean_params[str(k)] = str(v)
    clean_cookies: dict[str, str] = {}
    if cookies:
        for k, v in cookies.items():
            if v is not None:
                clean_cookies[str(k)] = str(v)
    clean_body: Any = body
    if body_kind == "form" and isinstance(body, dict):
        clean_body = {str(k): str(v) for k, v in body.items() if v is not None}
    extra_dict: dict[str, Any] = {}
    if extra:
        for k, v in extra.items():
            if k == "headers" and isinstance(v, Mapping):
                for hk, hv in v.items():
                    if hv is not None:
                        clean_headers[str(hk)] = str(hv)
            elif k == "params" and isinstance(v, Mapping):
                for pk, pv in v.items():
                    if pv is None:
                        continue
                    if isinstance(pv, list):
                        clean_params[str(pk)] = [str(x) for x in pv if x is not None]
                    else:
                        clean_params[str(pk)] = str(pv)
            elif k == "cookies" and isinstance(v, Mapping):
                for ck, cv in v.items():
                    if cv is not None:
                        clean_cookies[str(ck)] = str(cv)
            elif v is not None:
                extra_dict[str(k)] = v
    return HttpRequest(
        method=method,
        url=url,
        headers=clean_headers,
        params=clean_params,
        cookies=clean_cookies,
        body=clean_body,
        body_kind=body_kind,
        extra=extra_dict,
    )

_T = TypeVar("_T")


@dataclass(slots=True, frozen=True)
class Ok(Generic[_T]):
    status: int
    headers: dict[str, str]
    value: _T
    ok: Literal[True] = True

    @property
    def is_ok(self) -> Literal[True]:
        return True


@dataclass(slots=True, frozen=True)
class UnknownErr:
    status: int
    headers: dict[str, str]
    body: Any = None
    ok: Literal[False] = False

    @property
    def is_ok(self) -> Literal[False]:
        return False

    @property
    def value(self) -> Any:
        return self.body


@dataclass(slots=True, frozen=True)
class TransportErr:
    status: int = 0
    headers: dict[str, str] = field(default_factory=dict)
    cause: str = ""
    exception: BaseException | None = None
    ok: Literal[False] = False

    @property
    def is_ok(self) -> Literal[False]:
        return False


@dataclass(slots=True, frozen=True)
class DecodeErr:
    status: int
    headers: dict[str, str]
    body: Any
    cause: str
    exception: Exception | None = None
    ok: Literal[False] = False

    @property
    def is_ok(self) -> Literal[False]:
        return False


@dataclass(slots=True, frozen=True)
class ErrMatcher:
    status: int
    check: Callable[[dict[str, Any]], bool] | None
    factory: Callable[..., Any]


def rt_dispatch_response(
    matchers: list[ErrMatcher],
    resp: RawResponse,
    value_fn: Callable[[Any], Any] | None = None,
) -> Any:
    status = resp.status
    headers = resp.headers
    raw_text = resp.text
    parsed_body: Any = None
    json_err: Exception | None = None
    try:
        parsed_body = json.loads(raw_text)
    except Exception as e:
        json_err = e

    last_decode_err: Exception | None = None
    matched_error_rule = False
    for matcher in matchers:
        if status != matcher.status:
            continue
        if matcher.check is not None:
            if (
                json_err is not None
                or not isinstance(parsed_body, dict)
                or not matcher.check(parsed_body)
            ):
                continue
        matched_error_rule = True
        if json_err is not None:
            last_decode_err = json_err
            continue
        try:
            return matcher.factory(headers=headers, value=parsed_body)
        except (ValueError, KeyError, TypeError) as e:
            last_decode_err = e

    if 200 <= status < 300 and not matched_error_rule:
        if value_fn is None:
            return Ok(status=status, headers=headers, value=None)
        if json_err is not None:
            return DecodeErr(
                status=status,
                headers=headers,
                body=raw_text,
                cause=str(json_err),
                exception=json_err,
            )
        try:
            val = value_fn(parsed_body)
            return Ok(status=status, headers=headers, value=val)
        except (ValueError, KeyError, TypeError) as e:
            return DecodeErr(
                status=status,
                headers=headers,
                body=parsed_body,
                cause=str(e),
                exception=e,
            )

    if matched_error_rule and last_decode_err is not None:
        return DecodeErr(
            status=status,
            headers=headers,
            body=parsed_body if json_err is None else raw_text,
            cause=str(last_decode_err),
            exception=last_decode_err,
        )

    fallback_body: Any = parsed_body if json_err is None else (raw_text if raw_text else None)
    return UnknownErr(status=status, headers=headers, body=fallback_body)

def rt_rest_call(
    transport: SyncTransport,
    req: HttpRequest,
    matchers: list[ErrMatcher],
    value_fn: Callable[[Any], Any] | None = None,
) -> Any:
    try:
        resp = transport.send(req)
    except TransportError as e:
        return TransportErr(status=0, cause=repr(e.cause), exception=e.cause)
    return rt_dispatch_response(matchers, resp, value_fn)

async def rt_rest_call_async(
    transport: AsyncTransport,
    req: HttpRequest,
    matchers: list[ErrMatcher],
    value_fn: Callable[[Any], Any] | None = None,
) -> Any:
    try:
        resp = await transport.send(req)
    except TransportError as e:
        return TransportErr(status=0, cause=repr(e.cause), exception=e.cause)
    return rt_dispatch_response(matchers, resp, value_fn)
