  if (responsePath) {
    const data = rtExtractPath(JSON.parse(resp.text), responsePath);
    if (responseJoin && Array.isArray(data)) {
      return data.map((x) => String(x)).join(responseJoin);
    }
    return String(data ?? "");
  }
  return resp.text;
}

