    }

    #[derive(Debug, PartialEq)]
    pub struct JsonRef<'a>(pub std::borrow::Cow<'a, Value>);

    impl<'a> JsonRef<'a> {
        pub fn as_str(&self) -> Option<&'a str> {
            match &self.0 {
                std::borrow::Cow::Borrowed(v) => v.as_str(),
                std::borrow::Cow::Owned(_) => None,
            }
        }

        pub fn clone(&self) -> Value {
            self.0.as_ref().clone()
        }
    }

    impl<'a> std::ops::Deref for JsonRef<'a> {
        type Target = Value;

        fn deref(&self) -> &Self::Target {
            &self.0
        }
    }

    fn next_gjson_segment(path: &str) -> (String, bool, Option<&str>) {
        let mut unescaped = String::with_capacity(path.len());
        let mut has_escape = false;
        let mut chars = path.char_indices().peekable();
        while let Some((idx, ch)) = chars.next() {
            if ch == '\\' {
                if let Some(&(_, next_ch)) = chars.peek() {
                    if matches!(next_ch, '.' | '\\' | '#') {
                        has_escape = true;
                        chars.next();
                        unescaped.push(next_ch);
                        continue;
                    }
                }
                unescaped.push('\\');
            } else if ch == '.' {
                return (unescaped, has_escape, Some(&path[idx + 1..]));
            } else {
                unescaped.push(ch);
            }
        }
        (unescaped, has_escape, None)
    }

    pub fn json_opt<'a>(value: &'a Value, path: &str) -> Option<JsonRef<'a>> {
        json_path(value, path, "").ok()
    }

    pub fn json_path<'a>(
        value: &'a Value,
        path: &str,
        context: &str,
    ) -> Result<JsonRef<'a>, RtError> {
        if path.is_empty() {
            return Ok(JsonRef(std::borrow::Cow::Borrowed(value)));
        }
        let mut current = value;
        let mut rem = Some(path);
        while let Some(r) = rem {
            let (segment, has_escape, next_rem) = next_gjson_segment(r);
            rem = next_rem;
            if !has_escape && segment == "#" {
                let arr = current.as_array().ok_or_else(|| {
                    RtError::new(context, "expected JSON array for '#' operator")
                })?;
                return match rem {
                    None => Ok(JsonRef(std::borrow::Cow::Owned(Value::Number(
                        (arr.len() as u64).into(),
                    )))),
                    Some(subpath) => {
                        let mut out = Vec::new();
                        for item in arr {
                            if let Some(v) = json_opt(item, subpath) {
                                if !v.is_null() {
                                    out.push(v.0.into_owned());
                                }
                            }
                        }
                        Ok(JsonRef(std::borrow::Cow::Owned(Value::Array(out))))
                    }
                };
            }
            let next_val = if !has_escape {
                if let Ok(index) = segment.parse::<usize>() {
                    current.as_array().and_then(|arr| arr.get(index))
                } else {
                    current.get(segment.as_str())
                }
            } else {
                current.get(segment.as_str())
            };
            current = next_val.ok_or_else(|| {
                RtError::new(context, format!("missing JSON path segment '{segment}'"))
            })?;
        }
        Ok(JsonRef(std::borrow::Cow::Borrowed(current)))
    }

    pub fn extract_json_value(
        value: &Value,
        path: Option<&str>,
        context: &str,
    ) -> Result<Value, RtError> {
        match path {
            Some(p) if !p.is_empty() => Ok(json_path(value, p, context)?.0.into_owned()),
            _ => Ok(value.clone()),
        }
    }

    pub fn parse_json(value: &str, path: &str, context: &str) -> Result<Value, RtError> {
        let parsed: Value =
            serde_json::from_str(value).map_err(|e| RtError::new(context, e.to_string()))?;
        Ok(json_path(&parsed, path, context)?.0.into_owned())
    }

    pub type Dom = Rc<RefCell<Document>>;
    pub type Node = NodeId;
    pub type Nodes = Vec<NodeId>;

    pub fn root_id(dom: &Dom) -> NodeId {
        dom.borrow().root().id
    }

    pub fn parse_doc(input: impl Into<String>) -> (Dom, NodeId) {
        let document = Document::from(input.into());
        let dom = Rc::new(RefCell::new(document));
        let root = root_id(&dom);
        (dom, root)
    }

    pub fn root_nodes(dom: &Dom) -> Nodes {
        vec![root_id(dom)]
    }

    pub fn first_node(nodes: &Nodes, context: &str) -> Result<NodeId, RtError> {
        nodes
            .first()
            .copied()
            .ok_or_else(|| RtError::new(context, "value has no selected node"))
    }

    pub fn node_at(nodes: &Nodes, index: i64, context: &str) -> Result<Nodes, RtError> {
        let pos = if index < 0 {
            nodes.len() as i64 + index
        } else {
            index
        };
        if pos < 0 {
            return Err(RtError::new(context, "index out of bounds"));
        }
        nodes
            .get(pos as usize)
            .copied()
            .map(|id| vec![id])
            .ok_or_else(|| RtError::new(context, "index out of bounds"))
    }

    fn select_from<'a>(doc: &'a Document, root: NodeId, query: &str) -> Selection<'a> {
        if root == doc.root().id {
            doc.select(query)
        } else {
            Selection::from(NodeRef::new(root, &doc.tree)).select(query)
        }
    }

    pub fn select(
        dom: &Dom,
        roots: &Nodes,
        queries: &[&str],
        context: &str,
    ) -> Result<Nodes, RtError> {
        let doc = dom.borrow();
        for query in queries {
            if roots.is_empty() {
                continue;
            }
            for root in roots {
                let sel = select_from(&doc, *root, query);
                if let Some(first) = sel.nodes().first() {
                    return Ok(vec![first.id]);
                }
            }
        }
        Err(RtError::new(context, "selector matched no elements"))
    }

    pub fn select_opt(dom: &Dom, roots: &Nodes, queries: &[&str]) -> Nodes {
        let doc = dom.borrow();
        for query in queries {
            if roots.is_empty() {
                continue;
            }
            for root in roots {
                let sel = select_from(&doc, *root, query);
                if let Some(first) = sel.nodes().first() {
                    return vec![first.id];
                }
            }
        }
        Vec::new()
    }

    pub fn select_all(
        dom: &Dom,
        roots: &Nodes,
        queries: &[&str],
        _context: &str,
    ) -> Result<Nodes, RtError> {
        Ok(select_many(dom, roots, queries))
    }

    pub fn select_many(dom: &Dom, roots: &Nodes, queries: &[&str]) -> Nodes {
        let doc = dom.borrow();
        for query in queries {
            let mut out = Vec::new();
            for root in roots {
                out.extend(
                    select_from(&doc, *root, query)
                        .nodes()
                        .iter()
                        .map(|n| n.id),
                );
            }
            if !out.is_empty() {
                return out;
            }
        }
        Vec::new()
    }

    pub fn remove(dom: &Dom, roots: &Nodes) -> Result<Nodes, RtError> {
        let doc = dom.borrow();
        for id in roots {
            NodeRef::new(*id, &doc.tree).remove_from_parent();
        }
        Ok(roots.clone())
    }

    pub fn css_remove(
        dom: &Dom,
        roots: &Nodes,
        query: &str,
        context: &str,
    ) -> Result<Nodes, RtError> {
        let removed = select_all(dom, roots, &[query], context)?;
        remove(dom, &removed)?;
        Ok(roots.clone())
    }

    pub fn text(dom: &Dom, roots: &Nodes, context: &str) -> Result<String, RtError> {
        let doc = dom.borrow();
        roots
            .first()
            .map(|id| NodeRef::new(*id, &doc.tree).text().to_string())
            .ok_or_else(|| RtError::new(context, "value has no selected node"))
    }

    pub fn text_all(dom: &Dom, roots: &Nodes) -> Vec<String> {
        let doc = dom.borrow();
        roots
            .iter()
            .map(|id| NodeRef::new(*id, &doc.tree).text().to_string())
            .collect()
    }

    pub fn raw(dom: &Dom, roots: &Nodes, inner: bool, context: &str) -> Result<String, RtError> {
        let doc = dom.borrow();
        roots
            .first()
            .map(|id| {
                let node = NodeRef::new(*id, &doc.tree);
                if inner {
                    node.inner_html().to_string()
                } else {
                    node.html().to_string()
                }
            })
            .ok_or_else(|| RtError::new(context, "value has no selected node"))
    }

    pub fn raw_html(dom: &Dom, roots: &Nodes, inner: bool, context: &str) -> Result<String, RtError> {
        raw(dom, roots, inner, context)
    }

    pub fn raw_all(dom: &Dom, roots: &Nodes, inner: bool) -> Vec<String> {
        let doc = dom.borrow();
        roots
            .iter()
            .map(|id| {
                let node = NodeRef::new(*id, &doc.tree);
                if inner {
                    node.inner_html().to_string()
                } else {
                    node.html().to_string()
                }
            })
            .collect()
    }

    pub fn attr(dom: &Dom, roots: &Nodes, names: &[&str], context: &str) -> Result<String, RtError> {
        let doc = dom.borrow();
        let node = roots
            .first()
            .ok_or_else(|| RtError::new(context, "value has no selected node"))?;
        let node = NodeRef::new(*node, &doc.tree);
        names
            .iter()
            .find_map(|name| node.attr(name).map(|v| v.to_string()))
            .ok_or_else(|| RtError::new(context, "attribute not found"))
    }

    pub fn attr_opt(dom: &Dom, roots: &Nodes, names: &[&str]) -> Option<String> {
        let doc = dom.borrow();
        let node = roots.first()?;
        let node = NodeRef::new(*node, &doc.tree);
        names
            .iter()
            .find_map(|name| node.attr(name).map(|v| v.to_string()))
    }

    pub fn attr_list(
        dom: &Dom,
        roots: &Nodes,
        names: &[&str],
        context: &str,
    ) -> Result<Vec<String>, RtError> {
        let doc = dom.borrow();
        let mut out = Vec::with_capacity(roots.len());
        for id in roots {
            let node = NodeRef::new(*id, &doc.tree);
            let val = names
                .iter()
                .find_map(|name| node.attr(name).map(|v| v.to_string()))
                .ok_or_else(|| RtError::new(context, "attribute not found"))?;
            out.push(val);
        }
        Ok(out)
    }

    pub fn attr_multi(dom: &Dom, roots: &Nodes, names: &[&str]) -> Vec<String> {
        let doc = dom.borrow();
        let mut out = Vec::new();
        for id in roots {
            let node = NodeRef::new(*id, &doc.tree);
            for name in names {
                if let Some(val) = node.attr(name) {
                    let s = val.to_string();
                    if !s.is_empty() {
                        out.push(s);
                    }
                }
            }
        }
        out
    }

    pub fn attr_all(dom: &Dom, roots: &Nodes, names: &[&str]) -> Vec<String> {
        attr_multi(dom, roots, names)
    }

    pub fn node_bool(value: &Nodes) -> bool {
        !value.is_empty()
    }

    pub fn pred_css(dom: &Dom, roots: &Nodes, query: &str) -> bool {
        let doc = dom.borrow();
        roots
            .iter()
            .any(|id| !select_from(&doc, *id, query).is_empty())
    }

    pub fn pred_attr(dom: &Dom, roots: &Nodes, name: &str) -> Option<String> {
        let doc = dom.borrow();
        roots
            .first()
            .and_then(|id| NodeRef::new(*id, &doc.tree).attr(name).map(|v| v.to_string()))
    }

    pub fn pred_has_attr(dom: &Dom, roots: &Nodes, names: &[&str]) -> bool {
        let doc = dom.borrow();
        roots.first().is_some_and(|id| {
            let node = NodeRef::new(*id, &doc.tree);
            names.iter().any(|name| node.attr(name).is_some())
        })
    }

    pub fn pred_text(dom: &Dom, roots: &Nodes) -> String {
        text_all(dom, roots).join("")
    }
}

#[derive(Debug, Clone, PartialEq, Serialize)]
pub struct ProductCatalogType {
    pub clean_html: String,
    pub inner_html: String,
    pub title: String,
    pub slug: String,
    pub all_links: Vec<String>,
    pub media_urls: Vec<String>,
    pub tags: Vec<String>,
    pub first_tag: String,
    pub sku: i64,
    pub price: f64,
    pub in_stock: bool,
}

pub struct ProductCatalogParser {
    dom: rt::Dom,
    root: NodeId,
}

impl ProductCatalogParser {
    pub fn new(input: impl Into<String>) -> Result<Self, rt::RtError> {
        let document = Document::from(input.into());
        let dom = Rc::new(RefCell::new(document));
        let root = rt::root_id(&dom);
        let mut parser = Self {
            dom,
            root,
        };
        parser.init()?;
        Ok(parser)
    }

    fn from_existing(dom: rt::Dom, root: NodeId) -> Result<Self, rt::RtError> {
        let mut parser = Self {
            dom,
            root,
        };
        parser.init()?;
        Ok(parser)
    }

    fn root_nodes(&self) -> rt::Nodes { vec![self.root] }

    fn init(&mut self) -> Result<(), rt::RtError> {
        Ok(())
    }

    fn split_doc(&mut self, v: rt::Nodes) -> Result<rt::Nodes, rt::RtError> {
        let v1 = rt::select_all(&self.dom, &v, &[".product-card"], "ProductCatalog")?;
        Ok(v1)
    }

    fn clean_html(&mut self, v: rt::Nodes) -> Result<String, rt::RtError> {
        let _v1_removed = rt::select_all(&self.dom, &v, &[".ad, script"], "ProductCatalog.clean-html")?;
        rt::remove(&self.dom, &_v1_removed)?;
        let v1 = v.clone();
        let v2 = rt::raw(&self.dom, &v1, false, "ProductCatalog.clean-html")?;
        Ok(v2)
    }

    fn inner_html(&mut self, v: rt::Nodes) -> Result<String, rt::RtError> {
        let v1 = rt::raw(&self.dom, &v, true, "ProductCatalog.inner-html")?;
        Ok(v1)
    }

    fn title(&mut self, v: rt::Nodes) -> Result<String, rt::RtError> {
        let v1 = rt::select(&self.dom, &v, &["h2.title", "h3.fallback-title"], "ProductCatalog.title")?;
        let v2 = rt::text(&self.dom, &v1, "ProductCatalog.title")?;
        let v3 = rt::ltrim(v2, None);
        let v4 = rt::rtrim(v3, None);
        let v5 = rt::trim(v4, None);
        let v6 = rt::normalize_space(v5);
        let v7 = rt::unescape(v6);
        let v8 = rt::repl(v7, "foo", "bar");
        Ok(v8)
    }

    fn slug(&mut self, v: rt::Nodes) -> Result<String, rt::RtError> {
        let v1 = rt::select(&self.dom, &v, &["a.link"], "ProductCatalog.slug")?;
        let v2 = rt::attr(&self.dom, &v1, &["href"], "ProductCatalog.slug")?;
        let v3 = rt::rm_prefix(v2, "/");
        let v4 = rt::rm_suffix(v3, ".html");
        let v5 = rt::rm_prefix_suffix(v4, "-");
        let v6 = rt::lower(v5);
        let v7 = rt::fmt_value("https://example.test/{{}}?ref={{}}", &v6);
        Ok(v7)
    }

    fn all_links(&mut self, v: rt::Nodes) -> Result<Vec<String>, rt::RtError> {
        let v1 = rt::select_all(&self.dom, &v, &["a[href]"], "ProductCatalog.all-links")?;
        let v2 = rt::attr_list(&self.dom, &v1, &["href"], "ProductCatalog.all-links")?;
        Ok(v2)
    }

    fn media_urls(&mut self, v: rt::Nodes) -> Result<Vec<String>, rt::RtError> {
        let v1 = rt::select_all(&self.dom, &v, &["[href], [src], [data-src]"], "ProductCatalog.media-urls")?;
        let v2 = rt::attr_multi(&self.dom, &v1, &["href", "src", "data-src"]);
        let v3 = rt::unique(v2);
        Ok(v3)
    }

    fn tags(&mut self, v: rt::Nodes) -> Result<Vec<String>, rt::RtError> {
        let v1 = rt::select(&self.dom, &v, &[".tags"], "ProductCatalog.tags")?;
        let v2 = rt::text(&self.dom, &v1, "ProductCatalog.tags")?;
        let v3 = v2.split(",").map(str::to_string).collect::<Vec<_>>();
        let v4 = v3.into_iter().map(|value| rt::trim(value, None)).collect::<Vec<_>>();
        let v5 = v4.into_iter().map(|value| rt::upper(value)).collect::<Vec<_>>();
        let v6 = rt::slice_vec(&v5, 0, 3);
        Ok(v6)
    }

    fn first_tag(&mut self, v: rt::Nodes) -> Result<String, rt::RtError> {
        return Ok(match (|| -> Result<String, rt::RtError> {
            let v1 = rt::select(&self.dom, &v, &[".tags"], "ProductCatalog.first-tag")?;
            let v2 = rt::text(&self.dom, &v1, "ProductCatalog.first-tag")?;
            let v3 = v2.split(",").map(str::to_string).collect::<Vec<_>>();
            let v4 = v3.into_iter().map(|value| rt::trim(value, None)).collect::<Vec<_>>();
            let v5 = rt::item_at(&v4, 0, "ProductCatalog.first-tag")?;
            Ok(v5)
        })() { Ok(value) => value, Err(_) => "UNTAGGED".to_string() });
    }

    fn sku(&mut self, v: rt::Nodes) -> Result<i64, rt::RtError> {
        let v1 = rt::select(&self.dom, &v, &[".sku"], "ProductCatalog.sku")?;
        let v2 = rt::text(&self.dom, &v1, "ProductCatalog.sku")?;
        let v3 = rt::regex_search(v2, "SKU-([0-9]+)", "ProductCatalog.sku")?;
        let v4 = rt::to_int(v3, "ProductCatalog.sku")?;
        Ok(v4)
    }

    fn price(&mut self, v: rt::Nodes) -> Result<f64, rt::RtError> {
        return Ok(match (|| -> Result<f64, rt::RtError> {
            let v1 = rt::select(&self.dom, &v, &[".price"], "ProductCatalog.price")?;
            let v2 = rt::text(&self.dom, &v1, "ProductCatalog.price")?;
            let v3 = rt::regex_sub(v2, "[^0-9.]", "", "ProductCatalog.price")?;
            let v4 = rt::to_float(v3, "ProductCatalog.price")?;
            Ok(v4)
        })() { Ok(value) => value, Err(_) => 0.0 });
    }

    fn in_stock(&mut self, v: rt::Nodes) -> Result<bool, rt::RtError> {
        let v1 = rt::select_opt(&self.dom, &v, &[".stock-badge"]);
        let v2 = rt::node_bool(&v1);
        Ok(v2)
    }

    pub fn parse(&mut self) -> Result<Vec<ProductCatalogType>, rt::RtError> {
        let rows = self.split_doc(self.root_nodes())?;
        let mut result = Vec::new();
        for row in rows {
            let row = vec![row];
            result.push(ProductCatalogType {
                clean_html: self.clean_html(row.clone())?,
                inner_html: self.inner_html(row.clone())?,
                title: self.title(row.clone())?,
                slug: self.slug(row.clone())?,
                all_links: self.all_links(row.clone())?,
                media_urls: self.media_urls(row.clone())?,
                tags: self.tags(row.clone())?,
                first_tag: self.first_tag(row.clone())?,
                sku: self.sku(row.clone())?,
                price: self.price(row.clone())?,
                in_stock: self.in_stock(row.clone())?,
            });
        }
        Ok(result)
    }

}
