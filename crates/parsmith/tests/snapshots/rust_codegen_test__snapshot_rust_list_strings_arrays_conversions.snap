    pub fn unique<T: Eq + std::hash::Hash + Clone>(value: Vec<T>) -> Vec<T> {
        let mut seen = HashSet::new();
        let mut out = Vec::new();
        for item in value {
            if seen.insert(item.clone()) {
                out.push(item);
            }
        }
        out
    }

