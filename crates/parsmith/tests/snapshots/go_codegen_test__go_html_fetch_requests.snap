// WithTimeout sets a per-call request timeout duration.
func WithTimeout(d time.Duration) RtHttpOption {
	return func(o *rtReqOpts) {
		o.Timeout = d
	}
}

type rtErrMatcher struct {
	Status  int
	Check   func([]byte) bool
	Factory func(int, []byte) error
}

func rtDispatchErr(matchers []rtErrMatcher, status int, headers rtHeaders, body []byte) error {
	_ = headers
	var lastDecodeErr error
	for _, m := range matchers {
		if m.Status == status {
			if m.Check == nil || m.Check(body) {
				if err := m.Factory(status, body); err != nil {
					if _, isDec := err.(*DecodeErr); isDec {
						lastDecodeErr = err
						continue
					}
					return err
				}
			}
		}
	}
	if status >= 400 && lastDecodeErr != nil {
		return lastDecodeErr
	}
	return nil
}

// DecodeErr — response body failed JSON parsing or schema validation.
type DecodeErr struct {
	Status int
	Body   string
	Cause  string
}

func (e *DecodeErr) Error() string {
	return fmt.Sprintf("parsmith: decode error (HTTP %d): %s", e.Status, e.Cause)
}

func (e *DecodeErr) IsError() bool {
	return true
}

// UnknownErr — unmatched HTTP >= 400 response.
type UnknownErr struct {
	Status int
	Body   string
}

func (e *UnknownErr) Error() string {
	return fmt.Sprintf("parsmith: unexpected HTTP %d: %s", e.Status, e.Body)
}

func (e *UnknownErr) IsError() bool {
	return true
}

// TransportErr — network/transport level failure.
type TransportErr struct {
	Cause string
}

func (e *TransportErr) Error() string {
	return "parsmith: transport error: " + e.Cause
}

func (e *TransportErr) IsError() bool {
	return true
}

func rtResolveOpts(dslOpts *rtReqOpts, opts ...rtReqOpt) *rtReqOpts {
	_opts := &rtReqOpts{}
	if dslOpts != nil {
		_opts.Body = dslOpts.Body
		_opts.Timeout = dslOpts.Timeout
		if len(dslOpts.Headers) > 0 {
			_opts.Headers = rtHeaders{}
			for k, vs := range dslOpts.Headers {
				_opts.Headers[k] = append([]string(nil), vs...)
			}
		}
		if len(dslOpts.Cookies) > 0 {
			_opts.Cookies = rtHeaders{}
			for k, vs := range dslOpts.Cookies {
				_opts.Cookies[k] = append([]string(nil), vs...)
			}
		}
		if len(dslOpts.Params) > 0 {
			_opts.Params = map[string][]string{}
			for k, vs := range dslOpts.Params {
				_opts.Params[k] = append([]string(nil), vs...)
			}
		}
	}
	for _, o := range opts {
		if o != nil {
			o(_opts)
		}
	}
	return _opts
}

func rtBuildURL(reqURL string, params map[string][]string) string {
	if len(params) == 0 {
		return reqURL
	}
	u, err := url.Parse(reqURL)
	if err != nil {
		return reqURL
	}
	q := u.Query()
	for k, vs := range params {
		for _, v := range vs {
			q.Add(k, v)
		}
	}
	u.RawQuery = q.Encode()
	return u.String()
}

func rtDoRequest(ctx context.Context, client *http.Client, method, reqURL string, dslOpts *rtReqOpts, opts ...rtReqOpt) (*http.Response, []byte, error) {
	if client == nil {
		client = http.DefaultClient
	}
	_opts := rtResolveOpts(dslOpts, opts...)
	if _opts.Timeout > 0 {
		var cancel context.CancelFunc
		ctx, cancel = context.WithTimeout(ctx, _opts.Timeout)
		defer cancel()
	}
	finalURL := rtBuildURL(reqURL, _opts.Params)
	req, err := http.NewRequestWithContext(ctx, method, finalURL, nil)
	if err != nil {
		return nil, nil, err
	}
	if len(_opts.Headers) > 0 {
		for k, vs := range _opts.Headers {
			for _, v := range vs {
				req.Header.Add(k, v)
			}
		}
	}
	if len(_opts.Cookies) > 0 {
		for name, vs := range _opts.Cookies {
			for _, v := range vs {
				req.AddCookie(&http.Cookie{Name: name, Value: v})
			}
		}
	}
	if _opts.Body != "" {
		req.Body = io.NopCloser(strings.NewReader(_opts.Body))
		req.ContentLength = int64(len(_opts.Body))
	}
	resp, err := client.Do(req)
	if err != nil {
		return nil, nil, err
	}
	defer resp.Body.Close()
	body, err := io.ReadAll(resp.Body)
	if err != nil {
		return resp, nil, err
	}
	return resp, body, nil
}

func rtDo(ctx context.Context, client *http.Client, method, reqURL string, dslOpts *rtReqOpts, opts ...rtReqOpt) (*http.Response, []byte, error) {
	return rtDoRequest(ctx, client, method, reqURL, dslOpts, opts...)
}

func rtExtractPath(raw []byte, responsePath string) (gjson.Result, error) {
	res := gjson.GetBytes(raw, responsePath)
	if !res.Exists() {
		return res, fmt.Errorf("parsmith: response-path %q not found", responsePath)
	}
	return res, nil
}

func rtExtractJSONSlice(raw []byte, responsePath string) ([]byte, error) {
	if responsePath != "" {
		res, err := rtExtractPath(raw, responsePath)
		if err != nil {
			return nil, err
		}
		return []byte(res.Raw), nil
	}
	return raw, nil
}

func rtRestCall(client *http.Client, matchers []rtErrMatcher, method, reqURL string, dslOpts *rtReqOpts, opts ...rtReqOpt) (int, []byte, error) {
	resp, bodyBytes, err := rtDoRequest(context.Background(), client, method, reqURL, dslOpts, opts...)
	if err != nil {
		return 0, nil, &TransportErr{Cause: err.Error()}
	}
	headers := rtHeaders{}
	for k, vs := range resp.Header {
		headers[k] = vs
	}
	if errObj := rtDispatchErr(matchers, resp.StatusCode, headers, bodyBytes); errObj != nil {
		return resp.StatusCode, nil, errObj
	}
	if resp.StatusCode >= 400 {
		return resp.StatusCode, nil, &UnknownErr{Status: resp.StatusCode, Body: string(bodyBytes)}
	}
	return resp.StatusCode, bodyBytes, nil
}

func rtRestCallValue[T any](client *http.Client, matchers []rtErrMatcher, method, reqURL, responsePath string, dslOpts *rtReqOpts, opts ...rtReqOpt) (*T, error) {
	status, body, err := rtRestCall(client, matchers, method, reqURL, dslOpts, opts...)
	if err != nil {
		return nil, err
	}
	slice, perr := rtExtractJSONSlice(body, responsePath)
	if perr != nil {
		return nil, &DecodeErr{Status: status, Body: string(body), Cause: perr.Error()}
	}
	var val T
	if perr := json.Unmarshal(slice, &val); perr != nil {
		return nil, &DecodeErr{Status: status, Body: string(body), Cause: perr.Error()}
	}
	return &val, nil
}

func rtRestCallSlice[T any](client *http.Client, matchers []rtErrMatcher, method, reqURL, responsePath string, dslOpts *rtReqOpts, opts ...rtReqOpt) ([]T, error) {
	status, body, err := rtRestCall(client, matchers, method, reqURL, dslOpts, opts...)
	if err != nil {
		return nil, err
	}
	slice, perr := rtExtractJSONSlice(body, responsePath)
	if perr != nil {
		return nil, &DecodeErr{Status: status, Body: string(body), Cause: perr.Error()}
	}
	if !gjson.ParseBytes(slice).IsArray() {
		return nil, &DecodeErr{Status: status, Body: string(body), Cause: "expected JSON array"}
	}
	val := make([]T, 0)
	if perr := json.Unmarshal(slice, &val); perr != nil {
		return nil, &DecodeErr{Status: status, Body: string(body), Cause: perr.Error()}
	}
	return val, nil
}

func rtRestCallVoid(client *http.Client, matchers []rtErrMatcher, method, reqURL string, dslOpts *rtReqOpts, opts ...rtReqOpt) (struct{}, error) {
	_, _, err := rtRestCall(client, matchers, method, reqURL, dslOpts, opts...)
	if err != nil {
		return struct{}{}, err
	}
	return struct{}{}, nil
}

func rtFetchHTML(ctx context.Context, client *http.Client, structName, method, reqURL, responsePath, responseJoin string, dslOpts *rtReqOpts, opts ...rtReqOpt) (string, error) {
	resp, body, err := rtDoRequest(ctx, client, method, reqURL, dslOpts, opts...)
	if err != nil {
		return "", &TransportErr{Cause: err.Error()}
	}
	if resp.StatusCode >= 400 {
		return "", fmt.Errorf("%s: HTTP %d: %s", structName, resp.StatusCode, string(body))
	}
	if responsePath != "" {
		if responseJoin != "" {
			_parts := gjson.GetBytes(body, responsePath).Array()
			_partsStrs := make([]string, len(_parts))
			for _i, _p := range _parts {
				_partsStrs[_i] = _p.String()
			}
			return strings.Join(_partsStrs, responseJoin), nil
		}
		return gjson.GetBytes(body, responsePath).String(), nil
	}
	return string(body), nil
}

func rtCssSelect(sel *goquery.Selection, queries ...string) *goquery.Selection {
	for _, q := range queries {
		res := sel.Find(q).First()
		if res.Length() > 0 {
			return res
		}
	}
	panic("parsmith: css selector matched no elements")
}

func rtTrim(s, cutset string) string {
	if cutset == "" {
		return strings.TrimSpace(s)
	}
	return strings.Trim(s, cutset)
}

// rtFallback runs fn with panic recovery, returning fallback on panic.
func rtFallback[T any](fn func() T, fallback T) (result T) {
	defer func() {
		if r := recover(); r != nil {
			result = fallback
		}
	}()
	return fn()
}

type ArticlePageType struct {
	Heading string `json:"heading"`
	Summary string `json:"summary"`
}

type ChunkedLogType struct {
	Lines []string `json:"lines"`
}

// Article HTML page parser with fetch methods.
type ArticlePage struct {
	sel *goquery.Selection
}

func NewArticlePage(input string) (*ArticlePage, error) {
	doc, err := goquery.NewDocumentFromReader(strings.NewReader(input))
	if err != nil {
		return nil, err
	}
	a := &ArticlePage{sel: doc.Selection}
	return a, nil
}

func (a *ArticlePage) parseHeading(v0 *goquery.Selection) string {
	v1 := rtCssSelect(v0, "h1")
	v2 := v1.Text()
	v3 := rtTrim(v2, "")
	return v3
}

func (a *ArticlePage) parseSummary(v0 *goquery.Selection) string {
	return rtFallback(func() string {
		v1 := rtCssSelect(v0, "p.summary")
		v2 := v1.Text()
		v3 := rtTrim(v2, "")
		return v3
	}, "")
}

func (a *ArticlePage) Parse() ArticlePageType {
	return ArticlePageType{
		Heading: a.parseHeading(a.sel),
		Summary: a.parseSummary(a.sel),
	}
}

// Fetch article by ID and query filters.
func NewArticlePageFetch(ctx context.Context, client *http.Client, id int64, sid string, trace string, theme string, q string, tags []string, pipes []int64, spaces []string, brackets []int64, repeats []string, opts ...rtReqOpt) (*ArticlePage, error) {
	body, err := rtFetchHTML(ctx, client, "ArticlePage", "GET", (fmt.Sprintf("https://example.com/articles/%d", id) + "?" + func() string {
		_values := url.Values{}
		_values.Set("q", fmt.Sprint(fmt.Sprintf("%s", q)))
		_tagsParts := make([]string, len(tags))
		for _i, _value := range tags {
			_tagsParts[_i] = fmt.Sprint(_value)
		}
		_values.Set("tags", strings.Join(_tagsParts, ","))
		_pipesParts := make([]string, len(pipes))
		for _i, _value := range pipes {
			_pipesParts[_i] = fmt.Sprint(_value)
		}
		_values.Set("pipes", strings.Join(_pipesParts, "|"))
		_spacesParts := make([]string, len(spaces))
		for _i, _value := range spaces {
			_spacesParts[_i] = fmt.Sprint(_value)
		}
		_values.Set("spaces", strings.Join(_spacesParts, " "))
		for _, _value := range brackets {
			_values.Add("brackets[]", fmt.Sprint(_value))
		}
		for _, _value := range repeats {
			_values.Add("repeats", fmt.Sprint(_value))
		}
		return _values.Encode()
	}()), "", "", &rtReqOpts{Headers: rtHeaders{"X-Static": []string{"parsmith-test"}, "X-Trace": []string{fmt.Sprintf("%s", trace)}}, Cookies: rtHeaders{"sid": []string{fmt.Sprintf("%s", sid)}, "theme": []string{fmt.Sprintf("%s", theme)}}}, opts...)
	if err != nil {
		return nil, err
	}
	return NewArticlePage(body)
}

func NewArticlePageBySlug(ctx context.Context, client *http.Client, slug string, token string, opts ...rtReqOpt) (*ArticlePage, error) {
	body, err := rtFetchHTML(ctx, client, "ArticlePage", "POST", fmt.Sprintf("https://example.com/articles/slug/%s", slug), "", "", &rtReqOpts{Body: url.Values{"mode": []string{"preview"}, "token": []string{fmt.Sprintf("%s", token)}}.Encode(), Headers: rtHeaders{"Content-Type": []string{"application/x-www-form-urlencoded"}}}, opts...)
	if err != nil {
		return nil, err
	}
	return NewArticlePage(body)
}

type ChunkedLog struct {
	sel string
}

func NewChunkedLog(input string) *ChunkedLog {
	c := &ChunkedLog{sel: input}
	return c
}

func (c *ChunkedLog) parseLines(v0 string) []string {
	v1 := strings.Split(v0, "\n")
	return v1
}

func (c *ChunkedLog) Parse() ChunkedLogType {
	return ChunkedLogType{
		Lines: c.parseLines(c.sel),
	}
}

func NewChunkedLogFetch(ctx context.Context, client *http.Client, streamId string, opts ...rtReqOpt) (*ChunkedLog, error) {
	body, err := rtFetchHTML(ctx, client, "ChunkedLog", "GET", fmt.Sprintf("https://example.com/logs/%s", streamId), "payload.lines", "\n", nil, opts...)
	if err != nil {
		return nil, err
	}
	return NewChunkedLog(body), nil
}
