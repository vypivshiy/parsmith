      if (!Array.isArray(current)) {
        if (isOptional) return null;
        throw new RtJsonPathError(
          `${prefix}Expected list for '#' in path '${path}', got ${rtTypeName(current)}`,
        );
      }
      if (i === segs.length - 1) return current.length;
      const subpath = segs
        .slice(i + 1)
        .map((s) => s.raw)
        .join(".");
