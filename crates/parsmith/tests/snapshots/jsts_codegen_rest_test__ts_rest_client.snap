    const _req = rtBuildRequest("GET", "https://api.example.com/me", { extra });
    return rtRestCall(transport, _req, RT_USER_API_MATCHERS, (_b: any) => rtProjectUser(rtResolveDotpath(_b, "data.user", false)));
  }

