  static getUser(transport: HttpTransport, id: number, includeMeta?: boolean | null, extra?: Record<string, unknown>): Promise<UserApiGetUserResult>;
  static getUser(transport: HttpTransport, params: { id: number; includeMeta?: boolean | null; include_meta?: boolean | null; [key: string]: unknown }, extra?: Record<string, unknown>): Promise<UserApiGetUserResult>;
  static async getUser(transport: HttpTransport, ..._args: any[]): Promise<UserApiGetUserResult> {
    const [{ id, includeMeta }, _extra] = rtExtractParams(_args, [["id"], ["includeMeta", "include_meta"]]);
    const _req = rtBuildRequest("GET", `https://api.example.com/users/${encodeURIComponent(String(id))}`, { headers: { "X-App": "parsmith" }, params: { include_meta: includeMeta }, extra: _extra });
    return rtRestCall(transport, _req, RT_USER_API_MATCHERS, rtProjectUser);
  }

  static get_user(transport: HttpTransport, id: number, includeMeta?: boolean | null, extra?: Record<string, unknown>): Promise<UserApiGetUserResult>;
  static get_user(transport: HttpTransport, params: { id: number; includeMeta?: boolean | null; include_meta?: boolean | null; [key: string]: unknown }, extra?: Record<string, unknown>): Promise<UserApiGetUserResult>;
  static async get_user(transport: HttpTransport, ..._args: any[]): Promise<UserApiGetUserResult> {
    return (this.getUser as any)(transport, ..._args);
  }

  static createUser(transport: HttpTransport, sid: string, tag: string, name: string, active: boolean, trace?: string | null, pref?: string | null, filter?: string | null, nickname?: string | null, extra?: Record<string, unknown>): Promise<UserApiCreateUserResult>;
  static createUser(transport: HttpTransport, params: { sid: string; tag: string; name: string; active: boolean; trace?: string | null; pref?: string | null; filter?: string | null; nickname?: string | null; [key: string]: unknown }, extra?: Record<string, unknown>): Promise<UserApiCreateUserResult>;
  static async createUser(transport: HttpTransport, ..._args: any[]): Promise<UserApiCreateUserResult> {
    const [{ sid, tag, name, active, trace, pref, filter, nickname }, _extra] = rtExtractParams(_args, [["sid"], ["tag"], ["name"], ["active"], ["trace"], ["pref"], ["filter"], ["nickname"]]);
    const _req = rtBuildRequest("POST", "https://api.example.com/users", { headers: { "Content-Type": "application/json", "X-Trace": trace }, params: { tag, filter }, cookies: { sid, pref }, body: { name, nickname: nickname ?? null, active }, bodyKind: "json", extra: _extra });
    return rtRestCall(transport, _req, RT_USER_API_MATCHERS, rtProjectUser);
  }

  static create_user(transport: HttpTransport, sid: string, tag: string, name: string, active: boolean, trace?: string | null, pref?: string | null, filter?: string | null, nickname?: string | null, extra?: Record<string, unknown>): Promise<UserApiCreateUserResult>;
  static create_user(transport: HttpTransport, params: { sid: string; tag: string; name: string; active: boolean; trace?: string | null; pref?: string | null; filter?: string | null; nickname?: string | null; [key: string]: unknown }, extra?: Record<string, unknown>): Promise<UserApiCreateUserResult>;
