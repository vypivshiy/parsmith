export const RT_USER_API_MATCHERS: ErrMatcher[] = [
  { status: 200, check: (_b: Record<string, any>) => _b?.["error"]?.["code"] != null, factory: (headers: Record<string, string>, value: any): UserApiErr200Code => ({ ok: false, kind: "error", variant: "UserApiErr200Code", status: 200, headers, value: rtProjectApiError(value) }) },
  { status: 404, check: (_b: Record<string, any>) => _b?.["error"] === "Not Found", factory: (headers: Record<string, string>, value: any): UserApiErr404NotFound => ({ ok: false, kind: "error", variant: "UserApiErr404NotFound", status: 404, headers, value: rtProjectSpecificNotFoundError(value) }) },
  { status: 404, check: null, factory: (headers: Record<string, string>, value: any): UserApiErr404 => ({ ok: false, kind: "error", variant: "UserApiErr404", status: 404, headers, value: rtProjectGenericError(value) }) },
  { status: 400, check: null, factory: (headers: Record<string, string>, value: any): UserApiErr400 => ({ ok: false, kind: "error", variant: "UserApiErr400", status: 400, headers, value: rtProjectApiError(value) }) },
];

/**
 * User service REST client.
