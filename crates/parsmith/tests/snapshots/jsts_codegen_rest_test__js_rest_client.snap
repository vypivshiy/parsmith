    method,
    url,
    headers: cleanHeaders,
    params: cleanParams,
    cookies: cleanCookies,
    body: cleanBody,
    bodyKind,
    extra: extraDict,
  };
}

export function rtExtractParams(args, keys) {
  const out = {};
  let extra = {};
  if (
    args.length > 0 &&
    typeof args[0] === "object" &&
    args[0] !== null &&
    !Array.isArray(args[0])
  ) {
    const obj = args[0];
    const known = new Set();
    for (const names of keys) {
      const camel = names[0];
      for (const n of names) {
        known.add(n);
        if (out[camel] === undefined && obj[n] !== undefined) {
          out[camel] = obj[n];
        }
      }
    }
    for (const [k, v] of Object.entries(obj)) {
      if (!known.has(k) && v !== undefined) {
        if (k === "extra" && typeof v === "object" && v !== null && !Array.isArray(v)) {
          extra = { ...extra, ...v };
        } else {
          extra[k] = v;
        }
      }
    }
    if (
      args.length > 1 &&
      typeof args[1] === "object" &&
      args[1] !== null &&
      !Array.isArray(args[1])
    ) {
      extra = { ...extra, ...args[1] };
    }
  } else {
    for (let i = 0; i < keys.length; i++) {
      out[keys[i][0]] = args[i];
    }
    if (
      args.length > keys.length &&
      typeof args[keys.length] === "object" &&
      args[keys.length] !== null &&
      !Array.isArray(args[keys.length])
    ) {
      extra = args[keys.length];
    }
  }
  return [out, extra];
}

export function rtDispatchResponse(matchers, resp, valueFn = null) {
  const status = resp.status;
  const headers = resp.headers ?? {};
  const rawText = resp.text ?? "";
  let parsedBody = null;
  let jsonErr = null;
  try {
    parsedBody = JSON.parse(rawText);
  } catch (err) {
    jsonErr = err;
  }

  let lastDecodeErr = null;
  let matchedErrorRule = false;
  for (const matcher of matchers) {
    if (status !== matcher.status) {
      continue;
    }
    if (matcher.check !== null) {
      if (
        jsonErr !== null ||
        typeof parsedBody !== "object" ||
        parsedBody === null ||
        Array.isArray(parsedBody) ||
        !matcher.check(parsedBody)
      ) {
        continue;
      }
    }
    matchedErrorRule = true;
    if (jsonErr !== null) {
      lastDecodeErr = jsonErr;
      continue;
    }
    try {
      return matcher.factory(headers, parsedBody);
    } catch (err) {
      lastDecodeErr = err;
    }
  }

  if (status >= 200 && status < 300 && !matchedErrorRule) {
    if (valueFn === null) {
      return {
        ok: true,
        kind: "ok",
        status,
        headers,
        value: null,
      };
    }
    if (jsonErr !== null) {
      return {
        ok: false,
        kind: "decode",
        status,
        headers,
        body: rawText,
        cause: jsonErr instanceof Error ? jsonErr.message : String(jsonErr),
        exception: jsonErr,
      };
    }
    try {
      const val = valueFn(parsedBody);
      return {
        ok: true,
        kind: "ok",
        status,
        headers,
        value: val,
      };
    } catch (err) {
      return {
        ok: false,
        kind: "decode",
        status,
        headers,
        body: parsedBody,
        cause: err instanceof Error ? err.message : String(err),
        exception: err,
      };
    }
  }

  if (matchedErrorRule && lastDecodeErr !== null) {
    return {
      ok: false,
      kind: "decode",
      status,
      headers,
      body: jsonErr === null ? parsedBody : rawText,
      cause: lastDecodeErr instanceof Error ? lastDecodeErr.message : String(lastDecodeErr),
      exception: lastDecodeErr,
    };
  }

  const fallbackBody = jsonErr === null ? parsedBody : rawText ? rawText : null;
  return {
    ok: false,
    kind: "unknown",
    status,
    headers,
    body: fallbackBody,
  };
}

export async function rtRestCall(transport, req, matchers, valueFn = null) {
  let resp;
  try {
    resp = await transport.send(req);
  } catch (err) {
    if (err instanceof TransportError) {
      const causeVal = err.cause ?? err;
      return {
        ok: false,
        kind: "transport",
        status: 0,
        cause: String(causeVal),
        exception: causeVal,
      };
    }
    throw err;
  }
  return rtDispatchResponse(matchers, resp, valueFn);
}

export function rtProjectUser(data) {
  rtExpectObject(data, "User");
  let _v;
  const result = {
    id: rtJsonField(data, "id", "User"),
    name: rtJsonField(data, "name", "User"),
    nickname: rtJsonField(data, "nickname", "User", true),
  };
  if ((_v = rtJsonField(data, "role", "User", false, true)) !== undefined) result.role = _v;
  return result;
}

export function rtProjectArticleList(items) {
  return rtExpectArray(items, "ArticleList").map((data) => {
    rtExpectObject(data, "ArticleList");
    return {
      article_id: rtJsonField(data, "id", "ArticleList.article_id"),
      headline: rtJsonField(data, "title", "ArticleList.headline"),
    };
  });
}

export function rtProjectApiError(data) {
  rtExpectObject(data, "ApiError");
  return {
    code: rtJsonPath(data, "error.code", "ApiError.code"),
    message: rtJsonPath(data, "error.message", "ApiError.message"),
  };
}

export function rtProjectSpecificNotFoundError(data) {
  rtExpectObject(data, "SpecificNotFoundError");
  return {
    error: rtJsonField(data, "error", "SpecificNotFoundError"),
    code: rtJsonField(data, "code", "SpecificNotFoundError"),
  };
}

export function rtProjectGenericError(data) {
  rtExpectObject(data, "GenericError");
  return {
    message: rtJsonField(data, "message", "GenericError"),
  };
}

export const RT_USER_API_MATCHERS = [
  { status: 200, check: (_b) => _b?.["error"]?.["code"] != null, factory: (headers, value) => ({ ok: false, kind: "error", variant: "UserApiErr200Code", status: 200, headers, value: rtProjectApiError(value) }) },
  { status: 404, check: (_b) => _b?.["error"] === "Not Found", factory: (headers, value) => ({ ok: false, kind: "error", variant: "UserApiErr404NotFound", status: 404, headers, value: rtProjectSpecificNotFoundError(value) }) },
  { status: 404, check: null, factory: (headers, value) => ({ ok: false, kind: "error", variant: "UserApiErr404", status: 404, headers, value: rtProjectGenericError(value) }) },
  { status: 400, check: null, factory: (headers, value) => ({ ok: false, kind: "error", variant: "UserApiErr400", status: 400, headers, value: rtProjectApiError(value) }) },
];

/**
 * User service REST client.
 */
export class UserApi {
  /**
   * Fetch a user by ID.
   */
  static async getUser(transport, ..._args) {
    const [{ id, includeMeta }, _extra] = rtExtractParams(_args, [["id"], ["includeMeta", "include_meta"]]);
    const _req = rtBuildRequest("GET", `https://api.example.com/users/${encodeURIComponent(String(id))}`, { headers: { "X-App": "parsmith" }, params: { include_meta: includeMeta }, extra: _extra });
    return rtRestCall(transport, _req, RT_USER_API_MATCHERS, rtProjectUser);
  }

  static async get_user(transport, ..._args) {
    return this.getUser(transport, ..._args);
  }

  static async createUser(transport, ..._args) {
    const [{ sid, tag, name, active, trace, pref, filter, nickname }, _extra] = rtExtractParams(_args, [["sid"], ["tag"], ["name"], ["active"], ["trace"], ["pref"], ["filter"], ["nickname"]]);
    const _req = rtBuildRequest("POST", "https://api.example.com/users", { headers: { "Content-Type": "application/json", "X-Trace": trace }, params: { tag, filter }, cookies: { sid, pref }, body: { name, nickname: nickname ?? null, active }, bodyKind: "json", extra: _extra });
    return rtRestCall(transport, _req, RT_USER_API_MATCHERS, rtProjectUser);
  }

  static async create_user(transport, ..._args) {
    return this.createUser(transport, ..._args);
  }

  static async getProfileEnveloped(transport, extra = {}) {
    const _req = rtBuildRequest("GET", "https://api.example.com/me", { extra });
    return rtRestCall(transport, _req, RT_USER_API_MATCHERS, (_b) => rtProjectUser(rtResolveDotpath(_b, "data.user", false)));
  }

  static async get_profile_enveloped(transport, ..._args) {
    return this.getProfileEnveloped(transport, ..._args);
  }

  static async listArticles(transport, extra = {}) {
    const _req = rtBuildRequest("GET", "https://api.example.com/articles", { extra });
    return rtRestCall(transport, _req, RT_USER_API_MATCHERS, rtProjectArticleList);
  }

  static async list_articles(transport, ..._args) {
    return this.listArticles(transport, ..._args);
  }

  static async ping(transport, extra = {}) {
    const _req = rtBuildRequest("GET", "https://api.example.com/ping", { extra });
    return rtRestCall(transport, _req, RT_USER_API_MATCHERS);
  }
}
