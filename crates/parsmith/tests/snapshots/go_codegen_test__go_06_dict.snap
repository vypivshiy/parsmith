func rtAttr(sel *goquery.Selection, key string) string {
	if sel.Length() == 0 {
		panic("parsmith: empty selection for attr " + key)
	}
	val, ok := sel.Attr(key)
	if !ok {
		panic("parsmith: missing attribute " + key)
	}
	return val
}

func rtAttrMulti(sel *goquery.Selection, keys ...string) []string {
	out := make([]string, 0)
	sel.Each(func(_ int, s *goquery.Selection) {
		for _, k := range keys {
			if val, ok := s.Attr(k); ok && val != "" {
				out = append(out, val)
			}
		}
	})
	return out
}

func rtIndex[T any](arr []T, i int) T {
	if i < 0 {
		i += len(arr)
	}
	if i < 0 || i >= len(arr) {
		panic("parsmith: slice index out of range")
	}
	return arr[i]
}

