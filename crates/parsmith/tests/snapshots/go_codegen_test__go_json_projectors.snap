func rtCssSelect(sel *goquery.Selection, queries ...string) *goquery.Selection {
	for _, q := range queries {
		res := sel.Find(q).First()
		if res.Length() > 0 {
			return res
		}
	}
	panic("parsmith: css selector matched no elements")
}

func rtReSearch(pattern, value, msg string) string {
	re := regexp.MustCompile(pattern)
	m := re.FindStringSubmatch(value)
	if len(m) < 2 {
		panic("parsmith: " + msg)
	}
	return m[1]
}

func rtJsonify[T any](jsonStr, path string, target *T) {
	var raw string
	if path != "" {
		res := gjson.Get(jsonStr, path)
		if !res.Exists() {
			panic("parsmith: jsonify path not found: " + path)
		}
		raw = res.Raw
	} else {
		raw = jsonStr
	}
	if err := json.Unmarshal([]byte(raw), target); err != nil {
		panic("parsmith: json unmarshal failed: " + err.Error())
	}
}

