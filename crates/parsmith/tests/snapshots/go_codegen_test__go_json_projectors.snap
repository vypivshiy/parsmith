type JsonBasic struct {
	sel     *goquery.Selection
	rawJson string
}

func NewJsonBasic(input string) (*JsonBasic, error) {
	doc, err := goquery.NewDocumentFromReader(strings.NewReader(input))
	if err != nil {
		return nil, err
	}
	j := &JsonBasic{sel: doc.Selection}
	j.init()
	return j, nil
}

func (j *JsonBasic) init() {
	j.rawJson = j.initRawJson(j.sel)
}

func (j *JsonBasic) initRawJson(v0 *goquery.Selection) string {
	v1 := rtCssSelect(v0, "script#test-data")
	v2 := v1.Text()
	v3 := rtReSearch(`(\[.*\])`, v2, "json_proj.kdl:54:13 re-match failed at JsonBasic.@init.raw-json pattern=(\\[.*\\])")
	return v3
}

func (j *JsonBasic) parseFullPayload(v0 *goquery.Selection) []JsonQuoteJson {
	v1 := j.rawJson
	var v2 []JsonQuoteJson
	rtJsonify(v1, "", &v2)
	return v2
}

func (j *JsonBasic) parseFirstAuthor(v0 *goquery.Selection) JsonAuthorJson {
	v1 := j.rawJson
	var v2 JsonAuthorJson
	rtJsonify(v1, "0.author", &v2)
	return v2
}

func (j *JsonBasic) parseSecondAuthor(v0 *goquery.Selection) JsonAuthorJson {
	v1 := j.rawJson
	var v2 JsonAuthorJson
	rtJsonify(v1, "1.author", &v2)
	return v2
}

func (j *JsonBasic) Parse() JsonBasicType {
	return JsonBasicType{
		FullPayload:  j.parseFullPayload(j.sel),
		FirstAuthor:  j.parseFirstAuthor(j.sel),
		SecondAuthor: j.parseSecondAuthor(j.sel),
	}
}

