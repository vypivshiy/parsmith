    fn normalize_slice_range(len: i64, start: i64, end: i64) -> (usize, usize) {
        let norm = |n: i64| if n < 0 { (len + n).max(0) } else { n.min(len) };
        let s = norm(start);
        let e = norm(end);
        if s >= e {
            (0, 0)
        } else {
            (s as usize, e as usize)
        }
    }

