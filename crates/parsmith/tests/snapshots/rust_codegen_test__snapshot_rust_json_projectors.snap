#[derive(Debug, Clone, PartialEq, Serialize)]
pub struct CatalogExtractorType {
    pub catalog: ReleaseCatalogJson,
    pub envelope_catalog: ReleaseCatalogJson,
}

pub struct CatalogExtractorParser {
    source: String,
}

impl CatalogExtractorParser {
    pub fn new(input: impl Into<String>) -> Result<Self, rt::RtError> {
        let mut parser = Self {
            source: input.into(),
        };
        parser.init()?;
        Ok(parser)
    }

    fn init(&mut self) -> Result<(), rt::RtError> {
        Ok(())
    }

    fn catalog(&mut self, v: String) -> Result<ReleaseCatalogJson, rt::RtError> {
        let v1 = ReleaseCatalogJson::from_value(rt::parse_json(&v, "", "CatalogExtractor.catalog")?)?;
        Ok(v1)
    }

    fn envelope_catalog(&mut self, v: String) -> Result<ReleaseCatalogJson, rt::RtError> {
        let v1 = ReleaseCatalogJson::from_value(rt::parse_json(&v, "payload\\.data", "CatalogExtractor.envelope_catalog")?)?;
        Ok(v1)
    }

    pub fn parse(&mut self) -> Result<CatalogExtractorType, rt::RtError> {
        Ok(CatalogExtractorType {
            catalog: self.catalog(self.source.clone())?,
            envelope_catalog: self.envelope_catalog(self.source.clone())?,
        })
    }

}
