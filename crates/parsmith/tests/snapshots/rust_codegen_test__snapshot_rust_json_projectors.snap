        let re = Regex::new(pattern).map_err(|e| RtError::new(context, e.to_string()))?;
        let captures = re
            .captures(&value)
            .ok_or_else(|| RtError::new(context, "regex did not match"))?;
        Ok(captures
            .get(1)
            .or_else(|| captures.get(0))
            .unwrap()
            .as_str()
            .to_string())
    }

