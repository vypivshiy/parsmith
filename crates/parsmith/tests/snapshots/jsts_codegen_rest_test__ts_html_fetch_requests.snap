/**
 * Article HTML page parser with fetch methods.
 */
export class ArticlePage {
  private _doc: Document | Element;

  constructor(document: string | Document | Element) {
    this._doc = rtParseHtml(document);
  }

  private _parseHeading(v0: Document | Element): string {
    let v1 = v0.querySelector("h1");
    if (v1 === null) throw new Error("CSS selector matched no element");
    let v2 = v1.textContent ?? "";
    let v3 = v2.trim();
    return v3;
  }

  private _parseSummary(v0: Document | Element): string {
    try {
      let v1 = v0.querySelector("p.summary");
      if (v1 === null) throw new Error("CSS selector matched no element");
      let v2 = v1.textContent ?? "";
      let v3 = v2.trim();
      return v3;
    } catch (_e) {
      return "";
    }
  }

  parse(): ArticlePageType {
    return {
      heading: this._parseHeading(this._doc),
      summary: this._parseSummary(this._doc),
    };
  }

  /**
   * Fetch article by ID and query filters.
   */
  static fetch(transport: HttpTransport, id: number, sid: string, trace?: string | null, theme?: string | null, q?: string | null, tags?: string[] | null, pipes?: number[] | null, spaces?: string[] | null, brackets?: number[] | null, repeats?: string[] | null, extra?: Record<string, unknown>): Promise<ArticlePage>;
