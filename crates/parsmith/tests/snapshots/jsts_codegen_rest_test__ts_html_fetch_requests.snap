    const [{ id, sid, trace, theme, q, tags, pipes, spaces, brackets, repeats }, _extra] = rtExtractParams(_args, [["id"], ["sid"], ["trace"], ["theme"], ["q"], ["tags"], ["pipes"], ["spaces"], ["brackets"], ["repeats"]]);
    const _req = rtBuildRequest("GET", `https://example.com/articles/${encodeURIComponent(String(id))}`, { headers: { "X-Static": "parsmith-test", "X-Trace": trace }, params: { q, tags: (tags != null ? tags.map(String).join(",") : undefined), pipes: (pipes != null ? pipes.map(String).join("|") : undefined), spaces: (spaces != null ? spaces.map(String).join(" ") : undefined), "brackets[]": brackets, repeats }, cookies: { sid, theme }, extra: _extra });
    return new ArticlePage(await rtFetch(transport, _req));
  }

  static fetchBySlug(transport: HttpTransport, slug: string, token?: string | null, extra?: Record<string, unknown>): Promise<ArticlePage>;
  static fetchBySlug(transport: HttpTransport, params: { slug: string; token?: string | null; [key: string]: unknown }, extra?: Record<string, unknown>): Promise<ArticlePage>;
