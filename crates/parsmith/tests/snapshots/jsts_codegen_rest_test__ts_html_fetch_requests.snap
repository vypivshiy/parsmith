    return new ArticlePage(await rtFetch(transport, _req));
  }

  static fetch_by_slug(transport: HttpTransport, slug: string, token?: string | null, extra?: Record<string, unknown>): Promise<ArticlePage>;
  static fetch_by_slug(transport: HttpTransport, params: { slug: string; token?: string | null; [key: string]: unknown }, extra?: Record<string, unknown>): Promise<ArticlePage>;
