// Code generated by parsmith. DO NOT EDIT.

package main

// Focused coverage: flat structs and @init cached values.

import (
	"github.com/PuerkitoBio/goquery"
	"strings"
)

func rtAttrList(sel *goquery.Selection, key string) []string {
	out := make([]string, 0, sel.Length())
	sel.Each(func(_ int, s *goquery.Selection) {
		val, ok := s.Attr(key)
		if !ok {
			panic("parsmith: missing attribute " + key)
		}
		out = append(out, val)
	})
	return out
}

// rtFallback runs fn with panic recovery, returning fallback on panic.
func rtFallback[T any](fn func() T, fallback T) (result T) {
	defer func() {
		if r := recover(); r != nil {
			result = fallback
		}
	}()
	return fn()
}

func rtIndex[T any](arr []T, i int) T {
	if i < 0 {
		i += len(arr)
	}
	if i < 0 || i >= len(arr) {
		panic("parsmith: slice index out of range")
	}
	return arr[i]
}

func rtCssSelect(sel *goquery.Selection, queries ...string) *goquery.Selection {
	for _, q := range queries {
		res := sel.Find(q).First()
		if res.Length() > 0 {
			return res
		}
	}
	panic("parsmith: css selector matched no elements")
}

func rtTrim(s, cutset string) string {
	if cutset == "" {
		return strings.TrimSpace(s)
	}
	return strings.Trim(s, cutset)
}

func rtTrimArr(arr []string, cutset string) []string {
	r := make([]string, len(arr))
	for i, s := range arr {
		r[i] = rtTrim(s, cutset)
	}
	return r
}

func rtUnique[T comparable](arr []T) []T {
	seen := make(map[T]bool)
	r := make([]T, 0, len(arr))
	for _, v := range arr {
		if !seen[v] {
			seen[v] = true
			r = append(r, v)
		}
	}
	return r
}

type FlatCoverageType = []string

type FlatCoverage struct {
	sel   *goquery.Selection
	hrefs []string
}

func NewFlatCoverage(input string) (*FlatCoverage, error) {
	doc, err := goquery.NewDocumentFromReader(strings.NewReader(input))
	if err != nil {
		return nil, err
	}
	f := &FlatCoverage{sel: doc.Selection}
	f.init()
	return f, nil
}

func (f *FlatCoverage) init() {
	f.hrefs = f.initHrefs(f.sel)
}

func (f *FlatCoverage) initHrefs(v0 *goquery.Selection) []string {
	v1 := v0.Find("a[href]")
	v2 := rtAttrList(v1, "href")
	return v2
}

func (f *FlatCoverage) parseCachedHrefs(v0 *goquery.Selection) []string {
	return rtFallback(func() []string {
		v1 := f.hrefs
		return v1
	}, []string{})
}

func (f *FlatCoverage) parseFilteredHrefs(v0 *goquery.Selection) []string {
	return rtFallback(func() []string {
		v1 := v0.Find("a[href]")
		v2 := rtAttrList(v1, "href")
		v3 := make([]string, 0)
		for _, i := range v2 {
			if strings.Contains(i, "https://") || strings.Contains(i, "/") {
				v3 = append(v3, i)
			}
		}
		return v3
	}, []string{})
}

func (f *FlatCoverage) parseFirstHref(v0 *goquery.Selection) string {
	return rtFallback(func() string {
		v1 := v0.Find("a[href]")
		v2 := rtAttrList(v1, "href")
		v3 := rtIndex(v2, 0)
		return v3
	}, "")
}

func (f *FlatCoverage) parseTokenParts(v0 *goquery.Selection) []string {
	return rtFallback(func() []string {
		v1 := rtCssSelect(v0, ".tokens")
		v2 := v1.Text()
		v3 := strings.Split(v2, ",")
		v4 := rtTrimArr(v3, "")
		return v4
	}, []string{})
}

func (f *FlatCoverage) Parse() []string {
	result := make([]string, 0)
	result = append(result, f.parseCachedHrefs(f.sel)...)
	result = append(result, f.parseFilteredHrefs(f.sel)...)
	result = append(result, f.parseFirstHref(f.sel))
	result = append(result, f.parseTokenParts(f.sel)...)
	return rtUnique(result)
}
