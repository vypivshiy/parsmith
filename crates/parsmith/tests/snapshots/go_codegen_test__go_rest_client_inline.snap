		return gjson.GetBytes(body, responsePath).String(), nil
	}
	return string(body), nil
}

func rtJSONBody(value any) string {
	body, err := json.Marshal(value)
	if err != nil {
		panic("parsmith: encode JSON body: " + err.Error())
	}
	return string(body)
