func (res *UserJson) UnmarshalJSON(raw []byte) error {
	g := gjson.ParseBytes(raw)
	if !g.IsObject() {
		return fmt.Errorf("UserJson: expected JSON object")
	}
	resId := gjson.GetBytes(raw, "id")
	if !resId.Exists() || resId.Type == gjson.Null {
		return fmt.Errorf("User.id: required JSON field 'id' missing")
	}
	if resId.Type != gjson.Number {
		return fmt.Errorf("User.id: expected JSON integer")
	}
	res.Id = resId.Int()
	resName := gjson.GetBytes(raw, "name")
	if !resName.Exists() || resName.Type == gjson.Null {
		return fmt.Errorf("User.name: required JSON field 'name' missing")
	}
	if resName.Type != gjson.String {
		return fmt.Errorf("User.name: expected JSON string")
	}
	res.Name = resName.String()
	if resNickname := gjson.GetBytes(raw, "nickname"); resNickname.Exists() && resNickname.Type != gjson.Null {
		if resNickname.Type != gjson.String {
			return fmt.Errorf("User.nickname: expected JSON string")
		}
		v := resNickname.String()
		res.Nickname = &v
	}
	if resRole := gjson.GetBytes(raw, "role"); resRole.Exists() && resRole.Type != gjson.Null {
		if resRole.Type != gjson.String {
			return fmt.Errorf("User.role: expected JSON string")
		}
		v := resRole.String()
		res.Role = &v
	}
	return nil
}

