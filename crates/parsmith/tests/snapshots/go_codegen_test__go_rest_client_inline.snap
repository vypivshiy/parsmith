// User service REST client.
type UserApi struct {
}

func NewUserApi() UserApi { return UserApi{} }

// Fetch a user by ID.
func (u UserApi) GetUser(client *http.Client, id int64, includeMeta bool, opts ...rtReqOpt) (*UserJson, error) {
	return rtRestCallValue[UserJson](client, rtUserApiMatchers, "GET", (fmt.Sprintf("https://api.example.com/users/%d", id) + "?" + url.Values{"include_meta": []string{fmt.Sprintf("%t", includeMeta)}}.Encode()), "", &rtReqOpts{Headers: rtHeaders{"X-App": []string{"parsmith"}}}, opts...)
}

func (u UserApi) CreateUser(client *http.Client, sid string, tag string, name string, active bool, trace string, pref string, filter string, nickname string, opts ...rtReqOpt) (*UserJson, error) {
	return rtRestCallValue[UserJson](client, rtUserApiMatchers, "POST", ("https://api.example.com/users" + "?" + url.Values{"tag": []string{fmt.Sprintf("%s", tag)}, "filter": []string{fmt.Sprintf("%s", filter)}}.Encode()), "", &rtReqOpts{Body: rtJSONBody(map[string]any{"name": name, "nickname": nickname, "active": active}), Headers: rtHeaders{"Content-Type": []string{"application/json"}, "X-Trace": []string{fmt.Sprintf("%s", trace)}}, Cookies: rtHeaders{"sid": []string{fmt.Sprintf("%s", sid)}, "pref": []string{fmt.Sprintf("%s", pref)}}}, opts...)
}

func (u UserApi) GetProfileEnveloped(client *http.Client, opts ...rtReqOpt) (*UserJson, error) {
	return rtRestCallValue[UserJson](client, rtUserApiMatchers, "GET", "https://api.example.com/me", "data.user", nil, opts...)
}

func (u UserApi) ListArticles(client *http.Client, opts ...rtReqOpt) ([]ArticleListJson, error) {
	return rtRestCallSlice[ArticleListJson](client, rtUserApiMatchers, "GET", "https://api.example.com/articles", "", nil, opts...)
}

func (u UserApi) Ping(client *http.Client, opts ...rtReqOpt) (struct{}, error) {
	return rtRestCallVoid(client, rtUserApiMatchers, "GET", "https://api.example.com/ping", nil, opts...)
}
