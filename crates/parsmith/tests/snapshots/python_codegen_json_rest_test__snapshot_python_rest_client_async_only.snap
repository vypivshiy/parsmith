GetUserResult: TypeAlias = Ok[UserJson] | UserApiErr200Code | UserApiErr404NotFound | UserApiErr404 | UserApiErr400 | UnknownErr | TransportErr | DecodeErr
UserApiGetUserResult: TypeAlias = GetUserResult

CreateUserResult: TypeAlias = Ok[UserJson] | UserApiErr200Code | UserApiErr404NotFound | UserApiErr404 | UserApiErr400 | UnknownErr | TransportErr | DecodeErr
UserApiCreateUserResult: TypeAlias = CreateUserResult

GetProfileEnvelopedResult: TypeAlias = Ok[UserJson] | UserApiErr200Code | UserApiErr404NotFound | UserApiErr404 | UserApiErr400 | UnknownErr | TransportErr | DecodeErr
UserApiGetProfileEnvelopedResult: TypeAlias = GetProfileEnvelopedResult

ListArticlesResult: TypeAlias = Ok[list[ArticleListJson]] | UserApiErr200Code | UserApiErr404NotFound | UserApiErr404 | UserApiErr400 | UnknownErr | TransportErr | DecodeErr
UserApiListArticlesResult: TypeAlias = ListArticlesResult

PingResult: TypeAlias = Ok[None] | UserApiErr200Code | UserApiErr404NotFound | UserApiErr404 | UserApiErr400 | UnknownErr | TransportErr | DecodeErr
UserApiPingResult: TypeAlias = PingResult

RT_USER_API_MATCHERS: list[ErrMatcher] = [
    ErrMatcher(200, lambda _b: (_v1.get('code') if isinstance(_v1 := (_b.get('error') if isinstance(_b, dict) else None), dict) else None) is not None, lambda headers, value: UserApiErr200Code(headers=headers, value=rt_project_api_error(value))),
    ErrMatcher(404, lambda _b: _b.get('error') == 'Not Found', lambda headers, value: UserApiErr404NotFound(headers=headers, value=rt_project_specific_not_found_error(value))),
    ErrMatcher(404, None, lambda headers, value: UserApiErr404(headers=headers, value=rt_project_generic_error(value))),
    ErrMatcher(400, None, lambda headers, value: UserApiErr400(headers=headers, value=rt_project_api_error(value))),
]

class UserApi:
    """User service REST client."""
    @classmethod
    async def async_get_user(cls, transport: AsyncTransport, id: int, include_meta: bool | None = None, **kwargs: Any) -> GetUserResult:
        """Fetch a user by ID."""
        _req = rt_build_request('GET', f"https://api.example.com/users/{id}", headers={'X-App': 'parsmith'}, params={'include_meta': include_meta}, extra=kwargs)
        return cast(GetUserResult, await rt_rest_call_async(transport, _req, RT_USER_API_MATCHERS, value_fn=rt_project_user))

    @classmethod
    async def async_create_user(cls, transport: AsyncTransport, sid: str, tag: str, name: str, active: bool, trace: str | None = None, pref: str | None = None, filter: str | None = None, nickname: str | None = None, **kwargs: Any) -> CreateUserResult:
        _req = rt_build_request('POST', 'https://api.example.com/users', headers={'Content-Type': 'application/json', 'X-Trace': trace}, params={'tag': tag, 'filter': filter}, cookies={'sid': sid, 'pref': pref}, body={'name': name, 'nickname': nickname, 'active': active}, body_kind='json', extra=kwargs)
        return cast(CreateUserResult, await rt_rest_call_async(transport, _req, RT_USER_API_MATCHERS, value_fn=rt_project_user))

    @classmethod
    async def async_get_profile_enveloped(cls, transport: AsyncTransport, **kwargs: Any) -> GetProfileEnvelopedResult:
        _req = rt_build_request('GET', 'https://api.example.com/me', extra=kwargs)
        return cast(GetProfileEnvelopedResult, await rt_rest_call_async(transport, _req, RT_USER_API_MATCHERS, value_fn=lambda _b: rt_project_user(_b['data']['user'])))

    @classmethod
    async def async_list_articles(cls, transport: AsyncTransport, **kwargs: Any) -> ListArticlesResult:
        _req = rt_build_request('GET', 'https://api.example.com/articles', extra=kwargs)
        return cast(ListArticlesResult, await rt_rest_call_async(transport, _req, RT_USER_API_MATCHERS, value_fn=rt_project_article_list))

    @classmethod
    async def async_ping(cls, transport: AsyncTransport, **kwargs: Any) -> PingResult:
        _req = rt_build_request('GET', 'https://api.example.com/ping', extra=kwargs)
        return cast(PingResult, await rt_rest_call_async(transport, _req, RT_USER_API_MATCHERS))
