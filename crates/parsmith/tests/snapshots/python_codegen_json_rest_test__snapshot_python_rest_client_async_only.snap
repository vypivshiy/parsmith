    code: int
    message: str

def rt_project_api_error(data: Any) -> ApiErrorJson:
    _d = rt_expect_dict(data, 'ApiError')
    return cast(ApiErrorJson, {
        'code': rt_json_req_path(_d, 'error.code', 'ApiError.code'),
        'message': rt_json_req_path(_d, 'error.message', 'ApiError.message'),
    })

