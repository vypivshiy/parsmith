    #[derive(Debug, PartialEq)]
    pub struct JsonRef<'a>(pub std::borrow::Cow<'a, Value>);

    impl<'a> JsonRef<'a> {
        pub fn as_str(&self) -> Option<&'a str> {
            match &self.0 {
                std::borrow::Cow::Borrowed(v) => v.as_str(),
                std::borrow::Cow::Owned(_) => None,
            }
        }

        pub fn clone(&self) -> Value {
            self.0.as_ref().clone()
        }
    }

    impl<'a> std::ops::Deref for JsonRef<'a> {
        type Target = Value;

        fn deref(&self) -> &Self::Target {
            &self.0
        }
    }

    fn next_gjson_segment(path: &str) -> (String, bool, Option<&str>) {
        let mut unescaped = String::with_capacity(path.len());
        let mut has_escape = false;
        let mut chars = path.char_indices().peekable();
        while let Some((idx, ch)) = chars.next() {
            if ch == '\\' {
                if let Some(&(_, next_ch)) = chars.peek() {
                    if matches!(next_ch, '.' | '\\' | '#') {
                        has_escape = true;
                        chars.next();
                        unescaped.push(next_ch);
                        continue;
                    }
                }
                unescaped.push('\\');
            } else if ch == '.' {
                return (unescaped, has_escape, Some(&path[idx + 1..]));
            } else {
                unescaped.push(ch);
            }
        }
        (unescaped, has_escape, None)
    }

    pub fn json_opt<'a>(value: &'a Value, path: &str) -> Option<JsonRef<'a>> {
        json_path(value, path, "").ok()
    }

    pub fn json_path<'a>(
        value: &'a Value,
        path: &str,
        context: &str,
    ) -> Result<JsonRef<'a>, RtError> {
        if path.is_empty() {
            return Ok(JsonRef(std::borrow::Cow::Borrowed(value)));
        }
        let mut current = value;
        let mut rem = Some(path);
        while let Some(r) = rem {
            let (segment, has_escape, next_rem) = next_gjson_segment(r);
            rem = next_rem;
            if !has_escape && segment == "#" {
                let arr = current.as_array().ok_or_else(|| {
                    RtError::new(context, "expected JSON array for '#' operator")
                })?;
                return match rem {
                    None => Ok(JsonRef(std::borrow::Cow::Owned(Value::Number(
                        (arr.len() as u64).into(),
                    )))),
                    Some(subpath) => {
                        let mut out = Vec::new();
                        for item in arr {
                            if let Some(v) = json_opt(item, subpath) {
                                if !v.is_null() {
                                    out.push(v.0.into_owned());
                                }
                            }
                        }
                        Ok(JsonRef(std::borrow::Cow::Owned(Value::Array(out))))
                    }
                };
            }
            let next_val = if !has_escape {
                if let Ok(index) = segment.parse::<usize>() {
                    current.as_array().and_then(|arr| arr.get(index))
                } else {
                    current.get(segment.as_str())
                }
            } else {
                current.get(segment.as_str())
            };
            current = next_val.ok_or_else(|| {
                RtError::new(context, format!("missing JSON path segment '{segment}'"))
            })?;
        }
        Ok(JsonRef(std::borrow::Cow::Borrowed(current)))
    }

    pub fn extract_json_value(
        value: &Value,
        path: Option<&str>,
        context: &str,
    ) -> Result<Value, RtError> {
        match path {
            Some(p) if !p.is_empty() => Ok(json_path(value, p, context)?.0.into_owned()),
            _ => Ok(value.clone()),
        }
    }

    pub fn parse_json(value: &str, path: &str, context: &str) -> Result<Value, RtError> {
        let parsed: Value =
            serde_json::from_str(value).map_err(|e| RtError::new(context, e.to_string()))?;
        Ok(json_path(&parsed, path, context)?.0.into_owned())
    }

    #[derive(Debug, Clone)]
    pub enum ErrorCond {
        Null(&'static str),
        Bool(&'static str, bool),
        Int(&'static str, i64),
        Float(&'static str, f64),
        Str(&'static str, &'static str),
    }

    pub struct ErrorMatcher<E> {
        pub status: u16,
        pub required_keys: &'static [&'static str],
        pub conditions: &'static [ErrorCond],
        pub decode: fn(Value) -> Result<E, RtError>,
    }

    pub fn match_error_json(
        body: &Value,
        required_keys: &[&str],
        conditions: &[ErrorCond],
    ) -> bool {
        if body.is_null() {
            return false;
        }
        for &key in required_keys {
            if json_opt(body, key).is_none() {
                return false;
            }
        }
        for cond in conditions {
            let matched = match cond {
                ErrorCond::Null(path) => json_opt(body, path).map_or(true, |v| v.is_null()),
                ErrorCond::Bool(path, expected) => {
                    json_opt(body, path).and_then(|v| v.as_bool()) == Some(*expected)
                }
                ErrorCond::Int(path, expected) => {
                    json_opt(body, path).and_then(|v| v.as_i64()) == Some(*expected)
                }
                ErrorCond::Float(path, expected) => {
                    json_opt(body, path).and_then(|v| v.as_f64()) == Some(*expected)
                }
                ErrorCond::Str(path, expected) => {
                    json_opt(body, path).and_then(|v| v.as_str()) == Some(*expected)
                }
            };
            if !matched {
                return false;
            }
        }
        true
    }

    pub async fn fetch_html(
        req: reqwest::RequestBuilder,
        context: &str,
        response_path: Option<&str>,
        response_join: Option<&str>,
    ) -> Result<String, RtError> {
        let resp = req
            .send()
            .await
            .map_err(|e| RtError::new(context, e.to_string()))?;
        let status = resp.status().as_u16();
        let body = resp
            .text()
            .await
            .map_err(|e| RtError::new(context, e.to_string()))?;
        if status >= 400 {
            return Err(RtError::new(context, format!("HTTP {status}: {body}")));
        }
        if let Some(path) = response_path {
            let body_val = parse_json(&body, path, context)?;
            return Ok(match (body_val, response_join) {
                (Value::Array(items), Some(sep)) => items
                    .iter()
                    .map(|item| {
                        item.as_str()
                            .map(|s| s.to_string())
                            .unwrap_or_else(|| item.to_string())
                    })
                    .collect::<Vec<_>>()
                    .join(sep),
                (Value::String(s), _) => s,
                (other, _) => other.to_string(),
            });
        }
        Ok(body)
    }

    fn dispatch_rest_errors<E>(
        status: u16,
        text: &str,
        parsed_res: &Result<Value, serde_json::Error>,
        matchers: &[ErrorMatcher<E>],
    ) -> Result<Option<RtError>, E> {
        let mut last_decode_err: Option<RtError> = None;
        for m in matchers {
            if m.status != status {
                continue;
            }
            match parsed_res {
                Ok(val) => {
                    if match_error_json(val, m.required_keys, m.conditions) {
                        match (m.decode)(val.clone()) {
                            Ok(err_val) => return Err(err_val),
                            Err(e) => last_decode_err = Some(e),
                        }
                    }
                }
                Err(_) => {
                    if m.required_keys.is_empty() && m.conditions.is_empty() {
                        if let Ok(err_val) = (m.decode)(Value::String(text.to_owned())) {
                            return Err(err_val);
                        }
                    }
                }
            }
        }
        Ok(last_decode_err)
    }

    pub async fn rest_call<T, E>(
        req: reqwest::RequestBuilder,
        response_path: Option<&str>,
        context: &str,
        matchers: &[ErrorMatcher<E>],
        transport_err: fn(reqwest::Error) -> E,
        decode_err: fn(u16, RtError) -> E,
        unknown_err: fn(u16, Value) -> E,
    ) -> Result<T, E>
    where
        T: Decode,
    {
        let resp = req.send().await.map_err(transport_err)?;
        let status = resp.status().as_u16();
        let text = resp.text().await.map_err(transport_err)?;
        let parsed_res: Result<Value, serde_json::Error> = serde_json::from_str(&text);

        let last_decode_err = dispatch_rest_errors(status, &text, &parsed_res, matchers)?;

        if (200..300).contains(&status) {
            let parsed = parsed_res
                .map_err(|e| decode_err(status, RtError::new(context, e.to_string())))?;
            let target = extract_json_value(&parsed, response_path, context)
                .map_err(|e| decode_err(status, e))?;
            return decode::<T>(target, context).map_err(|e| decode_err(status, e));
        }

        if let Some(err) = last_decode_err {
            return Err(decode_err(status, err));
        }

        let unknown_val = parsed_res.unwrap_or_else(|_| Value::String(text));
        Err(unknown_err(status, unknown_val))
    }

    pub async fn rest_call_void<E>(
        req: reqwest::RequestBuilder,
        _context: &str,
        matchers: &[ErrorMatcher<E>],
        transport_err: fn(reqwest::Error) -> E,
        decode_err: fn(u16, RtError) -> E,
        unknown_err: fn(u16, Value) -> E,
    ) -> Result<(), E> {
        let resp = req.send().await.map_err(transport_err)?;
        let status = resp.status().as_u16();
        let text = resp.text().await.map_err(transport_err)?;
        let parsed_res: Result<Value, serde_json::Error> = serde_json::from_str(&text);

        let last_decode_err = dispatch_rest_errors(status, &text, &parsed_res, matchers)?;

        if (200..300).contains(&status) {
            return Ok(());
        }

        if let Some(err) = last_decode_err {
            return Err(decode_err(status, err));
        }

        let unknown_val = parsed_res.unwrap_or_else(|_| Value::String(text));
        Err(unknown_err(status, unknown_val))
    }
}

#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
pub struct UserJson {
    pub id: i64,
    pub name: String,
    pub nickname: Option<String>,
    #[serde(skip_serializing_if = "Option::is_none")]
    pub role: Option<String>,
}

impl UserJson {
    pub fn from_value(value: Value) -> Result<Self, rt::RtError> {
        value.as_object().ok_or_else(|| rt::RtError::new("User", "expected JSON object"))?;
        let id = match rt::json_path(&value, "id", "User.id") {
            Ok(raw) if !raw.is_null() => {
                rt::decode::<i64>(raw.clone(), "User.id")?
            },
            Ok(_) => return Err(rt::RtError::new("User.id", "required field is null")),
            Err(error) => return Err(error),
        };
        let name = match rt::json_path(&value, "name", "User.name") {
            Ok(raw) if !raw.is_null() => {
                rt::decode::<String>(raw.clone(), "User.name")?
            },
            Ok(_) => return Err(rt::RtError::new("User.name", "required field is null")),
            Err(error) => return Err(error),
        };
        let nickname = match rt::json_path(&value, "nickname", "User.nickname") {
            Ok(raw) if !raw.is_null() => {
                Some(rt::decode::<String>(raw.clone(), "User.nickname")?)
            },
            Ok(_) => None,
            Err(_) => None,
        };
        let role = match rt::json_path(&value, "role", "User.role") {
            Ok(raw) if !raw.is_null() => {
                Some(rt::decode::<String>(raw.clone(), "User.role")?)
            },
            Ok(_) => None,
            Err(_) => None,
        };
        Ok(Self {
            id,
            name,
            nickname,
            role,
        })
    }
}

impl rt::Decode for UserJson {
    fn decode(value: Value, _context: &str) -> Result<Self, rt::RtError> {
        Self::from_value(value)
    }
}

