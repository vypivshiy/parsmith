#[derive(Debug)]
pub enum UserApiError {
    Err200Code(ApiErrorJson),
    Err404NotFound(SpecificNotFoundErrorJson),
    Err404(GenericErrorJson),
    Err400(ApiErrorJson),
    Transport(reqwest::Error),
    Decode(u16, rt::RtError),
    Unknown(u16, serde_json::Value),
}

impl UserApiError {
    pub fn status(&self) -> Option<u16> {
        match self {
            Self::Err200Code(_) => Some(200),
            Self::Err404NotFound(_) => Some(404),
            Self::Err404(_) => Some(404),
            Self::Err400(_) => Some(400),
            Self::Decode(status, _) => Some(*status),
            Self::Unknown(status, _) => Some(*status),
            Self::Transport(_) => None,
        }
    }
}

impl std::fmt::Display for UserApiError {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            Self::Err200Code(body) => write!(f, "HTTP 200: {:?}", body),
            Self::Err404NotFound(body) => write!(f, "HTTP 404: {:?}", body),
            Self::Err404(body) => write!(f, "HTTP 404: {:?}", body),
            Self::Err400(body) => write!(f, "HTTP 400: {:?}", body),
            Self::Transport(err) => write!(f, "transport error: {}", err),
            Self::Decode(status, err) => write!(f, "HTTP {} decode error: {}", status, err),
            Self::Unknown(status, body) => write!(f, "HTTP {}: {}", status, body),
        }
    }
}

impl std::error::Error for UserApiError {
    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
        match self {
            Self::Transport(err) => Some(err),
            Self::Decode(_, err) => Some(err),
            _ => None,
        }
    }
}

impl From<reqwest::Error> for UserApiError {
    fn from(err: reqwest::Error) -> Self {
        Self::Transport(err)
    }
}

pub type UserApiEndpointError = UserApiError;
pub type EndpointError = UserApiError;
pub type UserApiErr200Code = ApiErrorJson;
pub type UserApiErr404NotFound = SpecificNotFoundErrorJson;
pub type UserApiErr404 = GenericErrorJson;
pub type UserApiErr400 = ApiErrorJson;

const RT_USER_API_MATCHERS: &[rt::ErrorMatcher<UserApiError>] = &[
    rt::ErrorMatcher {
        status: 200,
        required_keys: &["error.code"],
        conditions: &[],
        decode: |v| Ok(UserApiError::Err200Code(rt::decode::<ApiErrorJson>(v, "UserApiError::Err200Code")?)),
    },
    rt::ErrorMatcher {
        status: 404,
        required_keys: &[],
        conditions: &[rt::ErrorCond::Str("error", "Not Found")],
        decode: |v| Ok(UserApiError::Err404NotFound(rt::decode::<SpecificNotFoundErrorJson>(v, "UserApiError::Err404NotFound")?)),
    },
    rt::ErrorMatcher {
        status: 404,
        required_keys: &[],
        conditions: &[],
        decode: |v| Ok(UserApiError::Err404(rt::decode::<GenericErrorJson>(v, "UserApiError::Err404")?)),
    },
    rt::ErrorMatcher {
        status: 400,
        required_keys: &[],
        conditions: &[],
        decode: |v| Ok(UserApiError::Err400(rt::decode::<ApiErrorJson>(v, "UserApiError::Err400")?)),
    },
];

// User service REST client.
pub struct UserApi;

pub type UserApiParser = UserApi;

impl UserApi {
    pub fn new() -> Self {
        Self
    }

    // Fetch a user by ID.
    pub async fn get_user(client: &reqwest::Client, id: i64, include_meta: Option<bool>) -> Result<UserJson, UserApiError> {
        let mut req = client.request(reqwest::Method::GET, format!("https://api.example.com/users/{}", id));
        let _ = &mut req;
        let mut query_pairs: Vec<(&str, String)> = Vec::new();
        if let Some(val) = include_meta {
            query_pairs.push(("include_meta", val.to_string()));
        }
        req = req.query(&query_pairs);
        req = req.header("X-App", "parsmith");
        rt::rest_call::<UserJson, UserApiError>(req, None, "UserApi.get_user", RT_USER_API_MATCHERS, UserApiError::Transport, UserApiError::Decode, UserApiError::Unknown).await
    }

    pub async fn create_user(client: &reqwest::Client, sid: &str, tag: &str, name: &str, active: bool, trace: Option<&str>, pref: Option<&str>, filter: Option<&str>, nickname: Option<&str>) -> Result<UserJson, UserApiError> {
        let mut req = client.request(reqwest::Method::POST, "https://api.example.com/users");
        let _ = &mut req;
        let mut query_pairs: Vec<(&str, String)> = Vec::new();
        query_pairs.push(("tag", tag.to_string()));
        if let Some(val) = filter {
            query_pairs.push(("filter", val.to_string()));
        }
        req = req.query(&query_pairs);
        req = req.header("Content-Type", "application/json");
        if let Some(val) = trace {
            req = req.header("X-Trace", val.to_string());
        }
        let mut cookies: Vec<String> = Vec::new();
        cookies.push(format!("sid={sid}"));
        if let Some(val) = pref {
            cookies.push(format!("pref={val}"));
        }
        if !cookies.is_empty() {
            req = req.header("Cookie", cookies.join("; "));
        }
        req = req.json(&serde_json::json!({"name": (name), "nickname": (nickname), "active": (active)}));
        rt::rest_call::<UserJson, UserApiError>(req, None, "UserApi.create_user", RT_USER_API_MATCHERS, UserApiError::Transport, UserApiError::Decode, UserApiError::Unknown).await
    }

    pub async fn get_profile_enveloped(client: &reqwest::Client) -> Result<UserJson, UserApiError> {
        let mut req = client.request(reqwest::Method::GET, "https://api.example.com/me");
        let _ = &mut req;
        rt::rest_call::<UserJson, UserApiError>(req, Some("data.user"), "UserApi.get_profile_enveloped", RT_USER_API_MATCHERS, UserApiError::Transport, UserApiError::Decode, UserApiError::Unknown).await
    }

    pub async fn list_articles(client: &reqwest::Client) -> Result<Vec<ArticleListJson>, UserApiError> {
        let mut req = client.request(reqwest::Method::GET, "https://api.example.com/articles");
        let _ = &mut req;
        rt::rest_call::<Vec<ArticleListJson>, UserApiError>(req, None, "UserApi.list_articles", RT_USER_API_MATCHERS, UserApiError::Transport, UserApiError::Decode, UserApiError::Unknown).await
    }

    pub async fn ping(client: &reqwest::Client) -> Result<(), UserApiError> {
        let mut req = client.request(reqwest::Method::GET, "https://api.example.com/ping");
        let _ = &mut req;
        rt::rest_call_void(req, "UserApi.ping", RT_USER_API_MATCHERS, UserApiError::Transport, UserApiError::Decode, UserApiError::Unknown).await
    }

}
