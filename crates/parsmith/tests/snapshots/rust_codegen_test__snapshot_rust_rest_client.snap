    pub fn slice_vec<T: Clone>(value: &[T], start: i64, end: i64) -> Vec<T> {
        let (s, e) = normalize_slice_range(value.len() as i64, start, end);
        if s >= e {
            Vec::new()
        } else {
            value[s..e].to_vec()
        }
    }

