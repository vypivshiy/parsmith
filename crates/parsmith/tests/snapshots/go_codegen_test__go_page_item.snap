// Code generated by parsmith. DO NOT EDIT.

package main

// Item struct with @init, @pre-validate, @check, and nested struct.

import (
	"github.com/PuerkitoBio/goquery"
	"strings"
)

func rtCssSelect(sel *goquery.Selection, queries ...string) *goquery.Selection {
	for _, q := range queries {
		res := sel.Find(q).First()
		if res.Length() > 0 {
			return res
		}
	}
	panic("parsmith: css selector matched no elements")
}

func rtTrim(s, cutset string) string {
	if cutset == "" {
		return strings.TrimSpace(s)
	}
	return strings.Trim(s, cutset)
}

// rtFallback runs fn with panic recovery, returning fallback on panic.
func rtFallback[T any](fn func() T, fallback T) (result T) {
	defer func() {
		if r := recover(); r != nil {
			result = fallback
		}
	}()
	return fn()
}

func rtAttr(sel *goquery.Selection, key string) string {
	if sel.Length() == 0 {
		panic("parsmith: empty selection for attr " + key)
	}
	val, ok := sel.Attr(key)
	if !ok {
		panic("parsmith: missing attribute " + key)
	}
	return val
}

func rtAssert(cond bool, msg string) {
	if !cond {
		panic("parsmith: " + msg)
	}
}

type SingleCardType struct {
	Title  string `json:"title"`
	Active bool   `json:"active"`
}

type PageItemType struct {
	Heading   string         `json:"heading"`
	Canonical string         `json:"canonical"`
	Single    SingleCardType `json:"single"`
}

type SingleCard struct {
	sel *goquery.Selection
}

func NewSingleCard(input string) (*SingleCard, error) {
	doc, err := goquery.NewDocumentFromReader(strings.NewReader(input))
	if err != nil {
		return nil, err
	}
	s := &SingleCard{sel: doc.Selection}
	return s, nil
}

func (s *SingleCard) parseTitle(v0 *goquery.Selection) string {
	v1 := rtCssSelect(v0, "h1")
	v2 := v1.Text()
	v3 := rtTrim(v2, "")
	return v3
}

func (s *SingleCard) parseActive(v0 *goquery.Selection) bool {
	v1 := rtCssSelect(v0, ".is-active")
	v2 := v1.Text()
	v3 := v2 != ""
	return v3
}

func (s *SingleCard) Parse() SingleCardType {
	return SingleCardType{
		Title:  s.parseTitle(s.sel),
		Active: s.parseActive(s.sel),
	}
}

// Main page item parser.
type PageItem struct {
	sel          *goquery.Selection
	canonicalUrl string
}

func NewPageItem(input string) (*PageItem, error) {
	doc, err := goquery.NewDocumentFromReader(strings.NewReader(input))
	if err != nil {
		return nil, err
	}
	p := &PageItem{sel: doc.Selection}
	p.init()
	return p, nil
}

func (p *PageItem) init() {
	p.canonicalUrl = p.initCanonicalUrl(p.sel)
}

func (p *PageItem) initCanonicalUrl(v0 *goquery.Selection) string {
	return rtFallback(func() string {
		v1 := rtCssSelect(v0, "link[rel='canonical']")
		v2 := rtAttr(v1, "href")
		return v2
	}, "")
}

func (p *PageItem) preValidate(v0 *goquery.Selection) {
	rtAssert(v0.Find("section.single").Length() > 0, "missing single section")
}

func (p *PageItem) hasCards() bool {
	v0 := p.sel
	return rtFallback(func() bool {
		v1 := v0.Find(".card").First()
		v2 := v1.Length() > 0
		return v2
	}, false)
}

func (p *PageItem) parseHeading(v0 *goquery.Selection) string {
	v1 := rtCssSelect(v0, "body > h1")
	v2 := v1.Text()
	v3 := rtTrim(v2, "")
	return v3
}

func (p *PageItem) parseCanonical(v0 *goquery.Selection) string {
	v1 := p.canonicalUrl
	return v1
}

func (p *PageItem) parseSingle(v0 *goquery.Selection) SingleCardType {
	v1 := rtCssSelect(v0, "section.single")
	v2 := (&SingleCard{sel: v1}).Parse()
	return v2
}

func (p *PageItem) Parse() PageItemType {
	p.preValidate(p.sel)
	return PageItemType{
		Heading:   p.parseHeading(p.sel),
		Canonical: p.parseCanonical(p.sel),
		Single:    p.parseSingle(p.sel),
	}
}
