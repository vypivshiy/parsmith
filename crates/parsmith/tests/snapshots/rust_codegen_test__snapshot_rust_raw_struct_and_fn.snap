    #[derive(Debug, PartialEq)]
    pub struct JsonRef<'a>(pub std::borrow::Cow<'a, Value>);

    impl<'a> JsonRef<'a> {
        pub fn as_str(&self) -> Option<&'a str> {
            match &self.0 {
                std::borrow::Cow::Borrowed(v) => v.as_str(),
                std::borrow::Cow::Owned(_) => None,
            }
        }

        pub fn clone(&self) -> Value {
            self.0.as_ref().clone()
        }
    }

    impl<'a> std::ops::Deref for JsonRef<'a> {
        type Target = Value;

        fn deref(&self) -> &Self::Target {
            &self.0
        }
    }

    fn next_gjson_segment(path: &str) -> (String, bool, Option<&str>) {
        let mut unescaped = String::with_capacity(path.len());
        let mut has_escape = false;
        let mut chars = path.char_indices().peekable();
        while let Some((idx, ch)) = chars.next() {
            if ch == '\\' {
                if let Some(&(_, next_ch)) = chars.peek() {
                    if matches!(next_ch, '.' | '\\' | '#') {
                        has_escape = true;
                        chars.next();
                        unescaped.push(next_ch);
                        continue;
                    }
                }
                unescaped.push('\\');
            } else if ch == '.' {
                return (unescaped, has_escape, Some(&path[idx + 1..]));
            } else {
                unescaped.push(ch);
            }
        }
        (unescaped, has_escape, None)
    }

    pub fn json_opt<'a>(value: &'a Value, path: &str) -> Option<JsonRef<'a>> {
        json_path(value, path, "").ok()
    }

    pub fn json_path<'a>(
        value: &'a Value,
        path: &str,
        context: &str,
    ) -> Result<JsonRef<'a>, RtError> {
        if path.is_empty() {
            return Ok(JsonRef(std::borrow::Cow::Borrowed(value)));
        }
        let mut current = value;
        let mut rem = Some(path);
        while let Some(r) = rem {
            let (segment, has_escape, next_rem) = next_gjson_segment(r);
            rem = next_rem;
            if !has_escape && segment == "#" {
                let arr = current.as_array().ok_or_else(|| {
                    RtError::new(context, "expected JSON array for '#' operator")
                })?;
                return match rem {
                    None => Ok(JsonRef(std::borrow::Cow::Owned(Value::Number(
                        (arr.len() as u64).into(),
                    )))),
                    Some(subpath) => {
                        let mut out = Vec::new();
                        for item in arr {
                            if let Some(v) = json_opt(item, subpath) {
                                if !v.is_null() {
                                    out.push(v.0.into_owned());
                                }
                            }
                        }
                        Ok(JsonRef(std::borrow::Cow::Owned(Value::Array(out))))
                    }
                };
            }
            let next_val = if !has_escape {
                if let Ok(index) = segment.parse::<usize>() {
                    current.as_array().and_then(|arr| arr.get(index))
                } else {
                    current.get(segment.as_str())
                }
            } else {
                current.get(segment.as_str())
            };
            current = next_val.ok_or_else(|| {
                RtError::new(context, format!("missing JSON path segment '{segment}'"))
            })?;
        }
        Ok(JsonRef(std::borrow::Cow::Borrowed(current)))
    }

    pub fn extract_json_value(
        value: &Value,
        path: Option<&str>,
        context: &str,
    ) -> Result<Value, RtError> {
        match path {
            Some(p) if !p.is_empty() => Ok(json_path(value, p, context)?.0.into_owned()),
            _ => Ok(value.clone()),
        }
    }

    pub fn parse_json(value: &str, path: &str, context: &str) -> Result<Value, RtError> {
        let parsed: Value =
            serde_json::from_str(value).map_err(|e| RtError::new(context, e.to_string()))?;
        Ok(json_path(&parsed, path, context)?.0.into_owned())
    }
}

#[derive(Debug, Clone, PartialEq, Serialize)]
pub struct LogEntryType {
    pub level: String,
    pub message: String,
}

pub struct LogEntryParser {
    source: String,
}

impl LogEntryParser {
    pub fn new(input: impl Into<String>) -> Result<Self, rt::RtError> {
        let mut parser = Self {
            source: input.into(),
        };
        parser.init()?;
        Ok(parser)
    }

    fn init(&mut self) -> Result<(), rt::RtError> {
        Ok(())
    }

    fn split_doc(&mut self, v: String) -> Result<Vec<String>, rt::RtError> {
        let v1 = v.split("\n").map(str::to_string).collect::<Vec<_>>();
        Ok(v1)
    }

    fn level(&mut self, v: String) -> Result<String, rt::RtError> {
        return Ok(match (|| -> Result<String, rt::RtError> {
            let v1 = rt::regex_search(v, "^\\[([A-Z]+)\\]", "LogEntry.level")?;
            Ok(v1)
        })() { Ok(value) => value, Err(_) => "INFO".to_string() });
    }

    fn message(&mut self, v: String) -> Result<String, rt::RtError> {
        let v1 = rt::regex_sub(v, "^\\[[A-Z]+\\]\\s*", "", "LogEntry.message")?;
        let v2 = rt::trim(v1, None);
        Ok(v2)
    }

    pub fn parse(&mut self) -> Result<Vec<LogEntryType>, rt::RtError> {
        let rows = self.split_doc(self.source.clone())?;
        let mut result = Vec::new();
        for row in rows {
            result.push(LogEntryType {
                level: self.level(row.clone())?,
                message: self.message(row.clone())?,
            });
        }
        Ok(result)
    }

}

/// Extract semantic version from raw string.
pub fn extract_version(document: impl Into<String>) -> Result<String, rt::RtError> {
    let v = document.into();
    let v1 = rt::regex_search(v, "version=([0-9]+\\.[0-9]+\\.[0-9]+)", "extract_version")?;
    Ok(v1)
}
