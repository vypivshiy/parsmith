func rtReSearch(pattern, value, msg string) string {
	re := regexp.MustCompile(pattern)
	m := re.FindStringSubmatch(value)
	if len(m) < 2 {
		panic("parsmith: " + msg)
	}
	return m[1]
}

func rtIndex[T any](arr []T, i int) T {
	if i < 0 {
		i += len(arr)
	}
	if i < 0 || i >= len(arr) {
		panic("parsmith: slice index out of range")
	}
	return arr[i]
}

func rtRmPrefix(s, prefix string) string {
	return strings.TrimPrefix(s, prefix)
}

func rtToInt(s string) int64 {
	n, err := strconv.ParseInt(strings.TrimSpace(s), 10, 64)
	if err != nil {
		panic("parsmith: failed to parse int: " + s)
	}
	return n
}

func rtReSplit(pattern, value string) []string {
	return regexp.MustCompile(pattern).Split(value, -1)
}

